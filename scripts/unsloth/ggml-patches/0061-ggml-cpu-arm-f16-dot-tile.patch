CPU aarch64 (FP16-vector NEON builds without SVE: Apple Silicon, and Linux / Windows arm64 builds without SVE): an F16 x
F16 mul_mat (the GEMM inside every F16-kernel CONV_2D / CONV_3D, i.e. the VAE convolutions) computes a 2 x 3 tile of
ggml_vec_dot_f16 results per pass. Each output keeps vec_dot's arithmetic exactly (four FP16 FMA chains over k in
32-element steps, the same pairwise reduction, F32 widening and horizontal add), so the output is bit-identical; the
tile only reuses each loaded vector across 3 or 2 dot products instead of loading two vectors per FMA. 2-D operands
with k % 32 == 0 only; the rest, and GGML_CPU_F16_DOT_TILE=0, keep the per-element vec_dot.

diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
index 032fe4c..ddf6361 100644
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -1310,6 +1310,114 @@ void ggml_set_f32_nd(const struct ggml_tensor * tensor, int i0, int i1, int i2,
 
 // ggml_compute_forward_mul_mat
 
+
+#if defined(__ARM_NEON) && defined(__aarch64__) && defined(__ARM_FEATURE_FP16_VECTOR_ARITHMETIC) && !defined(__ARM_FEATURE_SVE)
+#define GGML_F16_DOT_TILE 1
+// F16 x F16 mul_mat on FP16-vector NEON builds: ggml_vec_dot_f16 over a 2 (src0 rows) x 3 (src1 columns) tile. Each
+// output keeps vec_dot's own arithmetic: four float16x8 FP16 FMA chains over k in 32-element steps (x = src0 row,
+// y = src1 column), the same pairwise reduction, the same F32 widening and horizontal add, so every value is
+// bit-identical; the tile only shares each loaded vector between 3 (src0) or 2 (src1) chains instead of reloading it
+// for every dot product. Needs k % 32 == 0 (vec_dot's scalar tail is not reproduced here).
+static inline float ggml_f16_dot_tile_reduce(float16x8_t s0, float16x8_t s1, float16x8_t s2, float16x8_t s3) {
+    s0 = vaddq_f16(s0, s2);
+    s1 = vaddq_f16(s1, s3);
+    s0 = vaddq_f16(s0, s1);
+    const float32x4_t t0 = vcvt_f32_f16(vget_low_f16(s0));
+    const float32x4_t t1 = vcvt_f32_f16(vget_high_f16(s0));
+    return (float) (ggml_float) vaddvq_f32(vaddq_f32(t0, t1));
+}
+
+static void ggml_f16_dot_tile_2x3(int n, const ggml_fp16_t * x0, const ggml_fp16_t * x1, const ggml_fp16_t * y0,
+                                  const ggml_fp16_t * y1, const ggml_fp16_t * y2, float * d0, float * d1, float * d2,
+                                  int64_t row1) {
+    float16x8_t a00 = vdupq_n_f16(0.0f), a01 = a00, a02 = a00, a03 = a00;  // row 0, col 0, chains 0..3
+    float16x8_t a10 = a00, a11 = a00, a12 = a00, a13 = a00;                // row 0, col 1
+    float16x8_t a20 = a00, a21 = a00, a22 = a00, a23 = a00;                // row 0, col 2
+    float16x8_t b00 = a00, b01 = a00, b02 = a00, b03 = a00;                // row 1, col 0
+    float16x8_t b10 = a00, b11 = a00, b12 = a00, b13 = a00;                // row 1, col 1
+    float16x8_t b20 = a00, b21 = a00, b22 = a00, b23 = a00;                // row 1, col 2
+    const __fp16 * px0 = (const __fp16 *) x0;
+    const __fp16 * px1 = (const __fp16 *) x1;
+    const __fp16 * py0 = (const __fp16 *) y0;
+    const __fp16 * py1 = (const __fp16 *) y1;
+    const __fp16 * py2 = (const __fp16 *) y2;
+#define GGML_F16_TILE_STEP(j, A0, A1, A2, B0, B1, B2)                                   \
+    {                                                                                   \
+        const float16x8_t r0 = vld1q_f16(px0 + i + 8 * (j));                            \
+        const float16x8_t r1 = vld1q_f16(px1 + i + 8 * (j));                            \
+        const float16x8_t c0 = vld1q_f16(py0 + i + 8 * (j));                            \
+        const float16x8_t c1 = vld1q_f16(py1 + i + 8 * (j));                            \
+        const float16x8_t c2 = vld1q_f16(py2 + i + 8 * (j));                            \
+        A0 = vfmaq_f16(A0, r0, c0); A1 = vfmaq_f16(A1, r0, c1); A2 = vfmaq_f16(A2, r0, c2); \
+        B0 = vfmaq_f16(B0, r1, c0); B1 = vfmaq_f16(B1, r1, c1); B2 = vfmaq_f16(B2, r1, c2); \
+    }
+    for (int i = 0; i < n; i += 32) {
+        GGML_F16_TILE_STEP(0, a00, a10, a20, b00, b10, b20)
+        GGML_F16_TILE_STEP(1, a01, a11, a21, b01, b11, b21)
+        GGML_F16_TILE_STEP(2, a02, a12, a22, b02, b12, b22)
+        GGML_F16_TILE_STEP(3, a03, a13, a23, b03, b13, b23)
+    }
+#undef GGML_F16_TILE_STEP
+    d0[0]    = ggml_f16_dot_tile_reduce(a00, a01, a02, a03);
+    d1[0]    = ggml_f16_dot_tile_reduce(a10, a11, a12, a13);
+    d2[0]    = ggml_f16_dot_tile_reduce(a20, a21, a22, a23);
+    d0[row1] = ggml_f16_dot_tile_reduce(b00, b01, b02, b03);
+    d1[row1] = ggml_f16_dot_tile_reduce(b10, b11, b12, b13);
+    d2[row1] = ggml_f16_dot_tile_reduce(b20, b21, b22, b23);
+}
+
+// one chunk of a 2-D F16 x F16 mul_mat (src1 F16, contiguous rows); edges through ggml_vec_dot_f16 itself
+static void ggml_f16_mul_mat_tiled_chunk(const struct ggml_tensor * src0, const struct ggml_tensor * src1, struct ggml_tensor * dst,
+                                         int64_t ir0_start, int64_t ir0_end, int64_t ir1_start, int64_t ir1_end) {
+    const int     n      = (int) src0->ne[0];
+    const size_t  nb01   = src0->nb[1];
+    const size_t  nb11   = src1->nb[1];
+    const size_t  nb1    = dst->nb[1];
+    const char *  a      = (const char *) src0->data;
+    const char *  b      = (const char *) src1->data;
+    char *        c      = (char *) dst->data;
+    const int64_t col1   = (int64_t) (nb1 / sizeof(float));
+    int64_t ir1 = ir1_start;
+    for (; ir1 + 3 <= ir1_end; ir1 += 3) {
+        const ggml_fp16_t * y0 = (const ggml_fp16_t *) (b + (ir1 + 0) * nb11);
+        const ggml_fp16_t * y1 = (const ggml_fp16_t *) (b + (ir1 + 1) * nb11);
+        const ggml_fp16_t * y2 = (const ggml_fp16_t *) (b + (ir1 + 2) * nb11);
+        float * d = (float *) (c + ir1 * nb1);
+        int64_t ir0 = ir0_start;
+        for (; ir0 + 2 <= ir0_end; ir0 += 2) {
+            ggml_f16_dot_tile_2x3(n, (const ggml_fp16_t *) (a + ir0 * nb01), (const ggml_fp16_t *) (a + (ir0 + 1) * nb01),
+                                  y0, y1, y2, d + ir0, d + col1 + ir0, d + 2 * col1 + ir0, 1);
+        }
+        for (; ir0 < ir0_end; ++ir0) {
+            const ggml_fp16_t * x = (const ggml_fp16_t *) (a + ir0 * nb01);
+            ggml_vec_dot_f16(n, d + ir0, 0, (ggml_fp16_t *) x, 0, (ggml_fp16_t *) y0, 0, 1);
+            ggml_vec_dot_f16(n, d + col1 + ir0, 0, (ggml_fp16_t *) x, 0, (ggml_fp16_t *) y1, 0, 1);
+            ggml_vec_dot_f16(n, d + 2 * col1 + ir0, 0, (ggml_fp16_t *) x, 0, (ggml_fp16_t *) y2, 0, 1);
+        }
+    }
+    for (; ir1 < ir1_end; ++ir1) {
+        const ggml_fp16_t * y = (const ggml_fp16_t *) (b + ir1 * nb11);
+        float * d = (float *) (c + ir1 * nb1);
+        for (int64_t ir0 = ir0_start; ir0 < ir0_end; ++ir0) {
+            ggml_vec_dot_f16(n, d + ir0, 0, (ggml_fp16_t *) (a + ir0 * nb01), 0, (ggml_fp16_t *) y, 0, 1);
+        }
+    }
+}
+
+static bool ggml_f16_mul_mat_tiled_ok(const struct ggml_compute_params * params, const struct ggml_tensor * src0,
+                                      const struct ggml_tensor * src1, const struct ggml_tensor * dst) {
+    static int env = -1;
+    if (env < 0) {
+        const char * v = getenv("GGML_CPU_F16_DOT_TILE");
+        env = v && v[0] == '0' && v[1] == 0 ? 0 : 1;
+    }
+    return env && !params->use_ref && src0->type == GGML_TYPE_F16 && src1->type == GGML_TYPE_F16 &&
+           dst->type == GGML_TYPE_F32 && src0->ne[0] % 32 == 0 &&
+           src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1 &&
+           src0->nb[0] == sizeof(ggml_fp16_t) && src1->nb[0] == sizeof(ggml_fp16_t) && dst->nb[0] == sizeof(float);
+}
+#endif
+
 static void ggml_compute_forward_mul_mat_one_chunk(
     const struct ggml_compute_params * params,
     struct ggml_tensor * dst,
@@ -1341,6 +1449,13 @@ static void ggml_compute_forward_mul_mat_one_chunk(
         return;
     }
 
+#ifdef GGML_F16_DOT_TILE
+    if (num_rows_per_vec_dot == 1 && type == GGML_TYPE_F16 && ggml_f16_mul_mat_tiled_ok(params, src0, src1, dst)) {
+        ggml_f16_mul_mat_tiled_chunk(src0, src1, dst, ir0_start, ir0_end, ir1_start, ir1_end);
+        return;
+    }
+#endif
