+    }
+    const int64_t nchunk = (nrows + rows - 1)/rows;
+    for (int64_t c = ith; c < nchunk; c = ggml_threadpool_chunk_add(params->threadpool, 1)) {
+        const int64_t r0 = c*rows;
+        f(r0, r0 + rows < nrows ? r0 + rows : nrows);
+    }
+}
