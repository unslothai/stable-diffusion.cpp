+// Unsloth: weight rows in chunks of up to max_rows (halved, never below 4, until there are 4 chunks per thread),
+// handed out through the threadpool's chunk counter like the tiled path: a thread on a busy or slower core no longer
+// holds the op up by a fixed band. ggml_compute_forward_mul_mat sets the counter to nth before the barrier that
+// precedes the compute call. A chunk starts at a multiple of 4 rows, and every 4-row group is computed the same way
+// whichever thread takes it, so the output is unchanged.
+template <typename F>
+void for_row_chunks(const struct ggml_compute_params * params, int64_t nrows, int64_t max_rows, int ith, int nth, F && f) {
+    int64_t rows = max_rows;
