 //////////////////////////////////////////////////////////////////////////////////////////
 // QUANT ZERO MATRIX MULTIPLICATION
 
+// Unsloth: the tiles of one quant gemm call handed out in chunks through the threadpool's chunk counter (as the
+// tiled path and tinyBLAS::gemm above do) instead of one fixed range per thread, so a thread on a busy or slower
+// core (an E-core, a noisy VM) no longer holds the whole op up by its share. Every thread sees the same tile grid
+// and a tile is computed the same way whichever thread takes it, so the output is unchanged. A single-threaded
+// call (legacy-q8 passes nth = 1) and a call with fewer than two tiles per thread keep the fixed ranges.
+class sgemm_tiles {
+  public:
+    sgemm_tiles(ggml_threadpool * tp, int ith, int nth, int64_t tiles) : tp(tp), tiles(tiles) {
+        steal = tp != nullptr && nth > 1 && tiles >= 2 * (int64_t) nth;
+        if (!steal) {
+            const int64_t duty = (tiles + nth - 1) / nth;
+            cur = duty * ith;
+            end = cur + duty < tiles ? cur + duty : tiles;
+            return;
+        }
+        const int64_t nchunk_max = 16 * (int64_t) nth;
+        size = (tiles + nchunk_max - 1) / nchunk_max;
+        nchunk = (tiles + size - 1) / size;
+        if (ith == 0) {
+            ggml_threadpool_chunk_set(tp, nth);
+        }
+        ggml_barrier(tp);
+        take(ith);
+    }
+    ~sgemm_tiles() {
+        if (steal) {
+            ggml_barrier(tp);  // nobody reads the counter once the next call resets it
+        }
+    }
+    bool next(int64_t & job) {
+        if (cur >= end) {
+            if (!steal) {
+                return false;
+            }
+            take(ggml_threadpool_chunk_add(tp, 1));
+            if (cur >= end) {
+                return false;
+            }
+        }
+        job = cur++;
+        return true;
+    }
+
+  private:
+    void take(int64_t c) {
+        cur = c < nchunk ? c * size : tiles;
+        end = cur + size < tiles ? cur + size : tiles;
+    }
+    ggml_threadpool * tp;
+    int64_t tiles;
+    bool steal = false;
+    int64_t size = 0, nchunk = 0, cur = 0, end = 0;
+};
