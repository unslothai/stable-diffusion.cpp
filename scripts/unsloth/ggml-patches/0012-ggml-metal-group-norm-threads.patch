diff --git a/src/ggml-metal/ggml-metal-ops.cpp b/src/ggml-metal/ggml-metal-ops.cpp
index e11d7c25..33121471 100644
--- a/src/ggml-metal/ggml-metal-ops.cpp
+++ b/src/ggml-metal/ggml-metal-ops.cpp
@@ -4103,13 +4103,16 @@ int ggml_metal_op_group_norm(ggml_metal_op_t ctx, int idx) {
 
     auto pipeline = ggml_metal_library_get_pipeline_group_norm(lib, op);
 
-    int nth = 32; // SIMD width
-    //while (nth < ne00/4 && nth < ggml_metal_pipeline_max_theads_per_threadgroup(pipeline)) {
-    //    nth *= 2;
-    //}
+    // one threadgroup per group: with a single simdgroup per group, a VAE / UNet group norm
+    // (32 groups of up to millions of elements) occupies only 32 simdgroups of the whole GPU.
+    // Scale the threadgroup with the group size (the kernel reduces across simdgroups through
+    // the 32-float threadgroup buffer, so up to 32 simdgroups = 1024 threads).
+    const int64_t gs = (int64_t) ne00*ne01*((ne02 + ngrp - 1)/ngrp);
 
-    //nth = std::min(nth, ggml_metal_pipeline_max_theads_per_threadgroup(pipeline));
-    //nth = std::min(nth, ne00/4);
+    int nth = 32; // SIMD width
+    while (nth < 1024 && (int64_t) nth*8 <= gs && nth < ggml_metal_pipeline_max_theads_per_threadgroup(pipeline)) {
+        nth *= 2;
+    }
 
     const size_t smem = pipeline.smem;
 
@@ -4120,7 +4123,9 @@ int ggml_metal_op_group_norm(ggml_metal_op_t ctx, int idx) {
 
     ggml_metal_encoder_set_threadgroup_memory_size(enc, smem, 0);
 
-    ggml_metal_encoder_dispatch_threadgroups(enc, ngrp, 1, 1, nth, 1, 1);
+    // one threadgroup per (group, batch): the kernel used to ignore ne03, leaving every batch
+    // after the first unnormalized
+    ggml_metal_encoder_dispatch_threadgroups(enc, ngrp*ne03, 1, 1, nth, 1, 1);
 
     return 1;
 }
diff --git a/src/ggml-metal/kernels/norm.metal b/src/ggml-metal/kernels/norm.metal
index c76d0c7f..613a8ca6 100644
--- a/src/ggml-metal/kernels/norm.metal
+++ b/src/ggml-metal/kernels/norm.metal
@@ -249,7 +249,12 @@ kernel void kernel_group_norm_f32(
     const int64_t ne = args.ne00*args.ne01*args.ne02;
     const int64_t gs = args.ne00*args.ne01*((args.ne02 + args.ngrp - 1) / args.ngrp);
 
-    int start = tgpig * gs;
+    // threadgroup tgpig normalizes group (tgpig % ngrp) of batch (tgpig / ngrp); src0 is contiguous
+    const int64_t i03 = tgpig / args.ngrp;
+    src0 += i03*ne;
+    dst  += i03*ne;
+
+    int start = (tgpig % args.ngrp) * gs;
     int end   = start + gs;
 
     start += tpitg;
@@ -294,6 +299,9 @@ kernel void kernel_group_norm_f32(
 
     tmp = simd_sum(tmp);
     if (ntg > N_SIMDWIDTH) {
+        // every simdgroup must have read the mean reduction from buf before it is reused
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
         if (sgitg == 0) {
             buf[tiisg] = 0.0f;
         }
