+#pragma once
+
+#include "common.cuh"
+
+// cuDNN scaled dot product attention for GGML_OP_FLASH_ATTN_EXT and GGML_OP_SAGE_ATTN on NVIDIA
+// sm80+ when the backend is built with GGML_CUDA_CUDNN and libcudnn 9 loads at run time.
+// Only unmasked, sink-free, ALiBi-free, softcap-free attention with equal Q/K/V head sizes and at
+// least 2^20 attention scores is taken; everything else, and every shape cuDNN rejects, keeps the
+// existing kernels.
+//
+// By default FLASH_ATTN_EXT takes it on sm89 and sm100 and SAGE_ATTN on sm100, where it measured faster.
+// Environment:
+//   GGML_CUDA_CUDNN_ATTN=0|1     never use cuDNN for attention / use it on every sm80+ GPU
+//   GGML_CUDA_CUDNN_SAGE=0|1     keep the SageAttention kernels for GGML_OP_SAGE_ATTN / use cuDNN on every
+//                                sm80+ GPU (AUTO mode; an explicitly requested Sage variant keeps its kernel)
+//   GGML_CUDA_CUDNN_ATTN_BF16=1  run cuDNN in BF16 instead of F16 (F16 K/V are narrowed)
+//   GGML_CUDA_CUDNN_LIB=path     library to open instead of libcudnn.so.9
+//   GGML_CUDA_CUDNN_ATTN_LOG=1   log every call that takes (or falls back from) the cuDNN path
+
+// Bytes the op needs from the graph allocation when the cuDNN path can run, 0 otherwise. The
+// region starts at dst->data and includes dst itself.
+size_t ggml_cuda_cudnn_attn_alloc_size(int device, const ggml_tensor * dst);
+
+// Runs dst through cuDNN. Returns false without touching dst when the cuDNN path does not apply,
+// so the caller runs its own kernel.
+bool ggml_cuda_cudnn_attn(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
