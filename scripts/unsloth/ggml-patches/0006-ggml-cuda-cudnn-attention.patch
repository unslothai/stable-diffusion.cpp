 src/ggml-cuda/CMakeLists.txt       |  49 ++++
 src/ggml-cuda/cudnn-attn-graph.cpp | 258 +++++++++++++++++++
 src/ggml-cuda/cudnn-attn-graph.h   |  31 +++
 src/ggml-cuda/cudnn-attn.cu        | 384 +++++++++++++++++++++++++++++
 src/ggml-cuda/cudnn-attn.cuh       |  26 ++
 src/ggml-cuda/fattn.cu             |   7 +-
 src/ggml-cuda/ggml-cuda.cu         |   2 +-
 src/ggml-cuda/sage-attn.cu         |  12 +-
 src/ggml-cuda/sage-attn.cuh        |   2 +-
 tests/test-backend-ops.cpp         |  25 ++
 11 files changed, 793 insertions(+), 6 deletions(-)
