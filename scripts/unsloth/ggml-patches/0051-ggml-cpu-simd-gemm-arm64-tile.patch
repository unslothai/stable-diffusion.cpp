simd_gemm (the F32 GEMM of the tiled CPU flash attention):
- AArch64: select the 4 x 4 register tile. The check was __ARM_NEON__ only; GCC defines just __ARM_NEON on
  AArch64 (Apple clang defines both), so Linux aarch64 builds used the 2 x 2 fallback tile.
- Rows past the last full GEMM_RM block (64 = 10 x 6 + 4 on AVX2) run as one block instead of one row at a time.
Every C element is still one FMA chain over k in order, so the results are bit-identical.

diff --git a/src/ggml-cpu/simd-gemm.h b/src/ggml-cpu/simd-gemm.h
index 4b9396d..d223d7b 100644
--- a/src/ggml-cpu/simd-gemm.h
+++ b/src/ggml-cpu/simd-gemm.h
@@ -7,17 +7,21 @@
 // TODO: add support for sizeless vector types
 #if defined(GGML_SIMD) && !defined(__ARM_FEATURE_SVE) && !defined(__riscv_v_intrinsic)
 
-// TODO: untested on avx512
 // These are in units of GGML_F32_EPR
-#if defined(__AVX512F__) || defined (__ARM_NEON__)
+// On AArch64, GCC and non-Apple clang define only __ARM_NEON (Apple clang defines both), so check both:
+// with only __ARM_NEON__, Linux and Windows arm64 builds fell through to the 2x2 tile below.
+#if defined(__AVX512F__) || defined(__ARM_NEON__) || defined(__ARM_NEON)
     static constexpr int GEMM_RM = 4;
     static constexpr int GEMM_RN = 4; // 16+4+1 = 25/32
+    #define GEMM_RM_MAX 4
 #elif defined(__AVX2__) || defined(__AVX__)
     static constexpr int GEMM_RM = 6;
     static constexpr int GEMM_RN = 2; // 12+2+1 = 15/16
+    #define GEMM_RM_MAX 6
 #else
     static constexpr int GEMM_RM = 2;
     static constexpr int GEMM_RN = 2;
+    #define GEMM_RM_MAX 2
 #endif
 
 template <int RM, int RN>
@@ -106,6 +110,28 @@ static inline void simd_gemm_ukernel_tail(
 #endif
 }
 
+// C[RM x N] += A[RM x K] * B[K x N], for RM rows at once
+template <int RM>
+static inline void simd_gemm_rows(
+    float       * GGML_RESTRICT C,
+    const float * GGML_RESTRICT A,
+    const float * GGML_RESTRICT B,
+    int K, int N)
+{
+    static constexpr int KN = GGML_F32_EPR;
+
+    int64_t jj = 0;
+    for (; jj + GEMM_RN * KN <= N; jj += GEMM_RN * KN) {
+        simd_gemm_ukernel<RM, GEMM_RN>(C + jj, A, B + jj, K, N);
+    }
+    for (; jj + KN <= N; jj += KN) {
+        simd_gemm_ukernel<RM, 1>(C + jj, A, B + jj, K, N);
+    }
+    if (jj < N) {
+        simd_gemm_ukernel_tail<RM>(C + jj, A, B + jj, K, N, N - jj);
+    }
+}
+
 // C[M x N] += A[M x K] * B[K x N]
 static void simd_gemm(
     float       * GGML_RESTRICT C,
@@ -132,21 +158,29 @@ static void simd_gemm(
         C += GEMM_RM * N;
     }
 
-    // Tail rows: one at a time
-    for (; ii < M; ii++) {
-        int64_t jj = 0;
-        for (; jj + GEMM_RN * KN <= N; jj += GEMM_RN * KN) {
-            simd_gemm_ukernel<1, GEMM_RN>(C + jj, A, B + jj, K, N);
-        }
-        for (; jj + KN <= N; jj += KN) {
-            simd_gemm_ukernel<1, 1>(C + jj, A, B + jj, K, N);
-        }
-        if (jj < N) {
-            simd_gemm_ukernel_tail<1>(C + jj, A, B + jj, K, N, N - jj);
-        }
-
-        A += K;
-        C += N;
+    // Tail rows (M % GEMM_RM of them) as one block. Every C element is still one FMA chain over
+    // kk in order, so the result is the same as computing these rows one at a time.
+    switch (M - ii) {
+        case 0: break;
+        case 1: simd_gemm_rows<1>(C, A, B, K, N); break;
+#if GEMM_RM_MAX > 2
+        case 2: simd_gemm_rows<2>(C, A, B, K, N); break;
+#endif
+#if GEMM_RM_MAX > 3
+        case 3: simd_gemm_rows<3>(C, A, B, K, N); break;
+#endif
+#if GEMM_RM_MAX > 4
+        case 4: simd_gemm_rows<4>(C, A, B, K, N); break;
+#endif
+#if GEMM_RM_MAX > 5
+        case 5: simd_gemm_rows<5>(C, A, B, K, N); break;
+#endif
+        default:
+            for (; ii < M; ii++) {
+                simd_gemm_rows<1>(C, A, B, K, N);
+                A += K;
+                C += N;
+            }
     }
 }
 #elif defined(GGML_SIMD) && defined(__riscv_v_intrinsic)
