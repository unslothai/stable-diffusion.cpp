index 401ceacb..b47563c6 100644
--- a/src/ggml-metal/kernels/rope.metal
+++ b/src/ggml-metal/kernels/rope.metal
@@ -331,3 +331,46 @@ template [[host_name("kernel_rope_multi_f16")]] kernel kernel_rope_multi_t kerne
 
 template [[host_name("kernel_rope_vision_f32")]] kernel kernel_rope_vision_t kernel_rope_vision<float>;
 template [[host_name("kernel_rope_vision_f16")]] kernel kernel_rope_vision_t kernel_rope_vision<half>;
+
+// x [d, n_head, L, N] (any strides), pe [2, 2, d/2, L] of [[cos, -sin], [sin, cos]]; dst contiguous [d, L, n_head*N]
+kernel void kernel_rope_apply_f32(
+        constant ggml_metal_kargs_rope_apply & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]]) {
+    const int64_t token = tgpig.x;
+    const int64_t head  = tgpig.y;
+    const int64_t batch = tgpig.z;
+
+    const int64_t half_dim = args.ne00/2;
+
+    device const char * x_row  = src0 + head*args.nb01 + token*args.nb02 + batch*args.nb03;
+    device const char * pe_row = src1 + token*args.nb13;
+    device       float * out   = (device float *) dst + (token + args.ne02*(head + args.ne01*batch))*args.ne00;
+
+    for (int64_t j = tpitg.x; j < half_dim; j += ntg.x) {
+        const int64_t i0 = args.interleaved ? 2*j     : j;
+        const int64_t i1 = args.interleaved ? 2*j + 1 : j + half_dim;
+
+        const float a = *(device const float *) (x_row + i0*args.nb00);
+        const float b = *(device const float *) (x_row + i1*args.nb00);
+
+        device const char * m = pe_row + j*args.nb12;
+
+        const float c = *(device const float *) (m);
+        const float s = *(device const float *) (m + args.nb11);
+
+        if (args.interleaved) {
+            const float neg_s = *(device const float *) (m + args.nb10);
+            const float c1    = *(device const float *) (m + args.nb10 + args.nb11);
+            out[i0] = a*c + b*neg_s;
+            out[i1] = a*s + b*c1;
+        } else {
+            out[i0] = a*c - b*s;
+            out[i1] = a*s + b*c;
+        }
+    }
+}
