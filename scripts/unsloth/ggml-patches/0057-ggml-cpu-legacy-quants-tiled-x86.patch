+static bool lqt_applies(int type, int64_t ne00, int64_t ne01, int64_t n) {
+    std::call_once(g_once, init_types);
+    return !g_convert_off && lqt_enabled(type) && ne00 % QK8_0 == 0 && ne01 % k_lqt_rows == 0 &&
