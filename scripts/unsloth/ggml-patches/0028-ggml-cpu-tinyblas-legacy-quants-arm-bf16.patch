+    // 32 unsigned weight codes, low nibbles of qs then high nibbles (bytes_from_nibbles_32)
+    static inline __m256i denibble(const uint8_t *p) {
+        __m128i x = _mm_loadu_si128((const __m128i *)p);
+        return _mm256_and_si256(_mm256_set1_epi8(15),
+                                _mm256_insertf128_si256(_mm256_castsi128_si256(x),
+                                                        _mm_srli_epi16(x, 4), 1));
+    }
+
+    inline __m256i load(const block_q4_1 *b) {
+        return denibble(b->qs);
+    }
+
+    // bit 4 of each code from qh, as bytes_from_bits_32(qh) & 0x10 in ggml_vec_dot_q5_1_q8_1
+    inline __m256i load(const block_q5_1 *b) {
+        uint32_t x32;
+        memcpy(&x32, b->qh, sizeof(uint32_t));
+        const __m256i shuf = _mm256_set_epi64x(0x0303030303030303, 0x0202020202020202,
+                                               0x0101010101010101, 0x0000000000000000);
+        __m256i bytes = _mm256_shuffle_epi8(_mm256_set1_epi32(x32), shuf);
+        bytes = _mm256_or_si256(bytes, _mm256_set1_epi64x(0x7fbfdfeff7fbfdfe));
+        bytes = _mm256_cmpeq_epi8(bytes, _mm256_set1_epi64x(-1));
+        return _mm256_or_si256(denibble(b->qs), _mm256_and_si256(bytes, _mm256_set1_epi8(0x10)));
+    }
