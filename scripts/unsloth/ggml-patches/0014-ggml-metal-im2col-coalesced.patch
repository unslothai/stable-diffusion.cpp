diff --git a/src/ggml-metal/kernels/conv.metal b/src/ggml-metal/kernels/conv.metal
index a5d5aa9d..16d7fc4f 100644
--- a/src/ggml-metal/kernels/conv.metal
+++ b/src/ggml-metal/kernels/conv.metal
@@ -64,6 +64,55 @@ kernel void kernel_im2col(
 template [[host_name("kernel_im2col_f32")]] kernel im2col_t kernel_im2col<float>;
 template [[host_name("kernel_im2col_f16")]] kernel im2col_t kernel_im2col<half>;
 
+// one thread per destination element along CHW (the contiguous dst dimension): full SIMD groups for small
+// kernels. kernel_im2col above runs KH*KW threads per threadgroup when N == 1, i.e. one thread for a 1x1 conv.
+// grid: [ceil(CHW/ntg0), OH, OW], threadgroup: [ntg0, 1, 1]
+template <typename T>
+kernel void kernel_im2col_flat(
+        constant ggml_metal_kargs_im2col & args,
+        device const float * x,
+        device        char * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3  tgpg[[threadgroups_per_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]]) {
+    const int64_t chw = (int64_t) tgpig[0]*ntg[0] + tpitg[0];
+    if (chw >= args.CHW) {
+        return;
+    }
+
+    const int64_t OH  = tgpg[1];
+    const int64_t OW  = tgpg[2];
+    const int64_t ioh = tgpig[1];
+    const int64_t iow = tgpig[2];
+
+    const int64_t iic = chw / args.KHW;
+    const int64_t khw = chw - iic*args.KHW;
+    const int64_t ikh = khw / args.KW;
+    const int64_t ikw = khw - ikh*args.KW;
+
+    const int64_t iiw = iow*args.s0 + ikw*args.d0 - args.p0;
+    const int64_t iih = ioh*args.s1 + ikh*args.d1 - args.p1;
+
+    const int64_t dst_n = OH*OW*(int64_t) args.CHW;
+
+    device T * pdst = (device T *) dst + (ioh*OW + iow)*args.CHW + chw;
+
+    if (iih < 0 || iih >= args.IH || iiw < 0 || iiw >= args.IW) {
+        for (int64_t in = 0; in < args.N; ++in) {
+            pdst[in*dst_n] = 0.0f;
+        }
+    } else {
+        device const float * px = x + iic*args.ofs1 + iih*args.IW + iiw;
+        for (int64_t in = 0; in < args.N; ++in) {
+            pdst[in*dst_n] = px[in*args.ofs0];
+        }
+    }
+}
+
+template [[host_name("kernel_im2col_flat_f32")]] kernel im2col_t kernel_im2col_flat<float>;
+template [[host_name("kernel_im2col_flat_f16")]] kernel im2col_t kernel_im2col_flat<half>;
