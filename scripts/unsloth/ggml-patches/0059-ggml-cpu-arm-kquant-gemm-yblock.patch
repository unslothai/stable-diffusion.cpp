+template <int YB>
+static void ggml_gemm_q4_K_8x4_q8_K_yb(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                                       const void * GGML_RESTRICT vy, int nr, int nc) {
+    ggml_gemm_q45_K_8x4_q8_K_yb<YB, false>(n, s, bs, vx, vy, nr, nc);
+}
+template <int YB>
+static void ggml_gemm_q5_K_8x4_q8_K_yb(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                                       const void * GGML_RESTRICT vy, int nr, int nc) {
+    ggml_gemm_q45_K_8x4_q8_K_yb<YB, true>(n, s, bs, vx, vy, nr, nc);
+}
