+#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// dotprod 8x4: Q4_K and Q5_K share the integer and float steps; only the weight unpack differs.
+template <int YB, bool IS_Q5>
+static void ggml_gemm_q45_K_8x4_q8_K_yb(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                                        const void * GGML_RESTRICT vy, int nr, int nc) {
+    constexpr int ncols_interleaved = 8;
+    constexpr int q8_k_blocklen     = 4;
+    constexpr int acc_size          = 2 * 4;
+    const int     nb                = n / QK_K;
+    const int     ny                = nr / q8_k_blocklen;
+    const uint8x16_t m4b            = vdupq_n_u8(0x0f);
+    const uint8x16_t mone           = vdupq_n_u8(1);
+    const uint8x16_t mtwo           = vdupq_n_u8(2);
+
+    for (int y0 = 0; y0 < ny; y0 += YB) {
+        const int yn = ny - y0 < YB ? ny - y0 : YB;
+        for (int x = 0; x < nc / ncols_interleaved; x++) {
+            float32x4_t acc_f32[YB][acc_size];
+            for (int yy = 0; yy < YB; yy++) {
+                for (int i = 0; i < acc_size; i++) {
+                    acc_f32[yy][i] = vdupq_n_f32(0);
+                }
+            }
+
+            for (int b = 0; b < nb; b++) {
+                const uint8_t * w_scales;
+                const uint8_t * w_qs;
+                const ggml_half * w_d;
+                const ggml_half * w_dmin;
+                if constexpr (IS_Q5) {
+                    const block_q5_Kx8 * blk = (const block_q5_Kx8 *) vx + (x * nb) + b;
+                    w_scales = blk->scales; w_qs = blk->qs; w_d = blk->d; w_dmin = blk->dmin;
+                } else {
+                    const block_q4_Kx8 * blk = (const block_q4_Kx8 *) vx + (x * nb) + b;
+                    w_scales = blk->scales; w_qs = blk->qs; w_d = blk->d; w_dmin = blk->dmin;
+                }
+                const float32x4_t w_d_0123    = vcvt_f32_f16(vld1_f16((const __fp16 *) w_d));
+                const float32x4_t w_d_4567    = vcvt_f32_f16(vld1_f16((const __fp16 *) w_d + 4));
+                const float32x4_t w_dmin_0123 = vcvt_f32_f16(vld1_f16((const __fp16 *) w_dmin));
+                const float32x4_t w_dmin_4567 = vcvt_f32_f16(vld1_f16((const __fp16 *) w_dmin + 4));
+
+                // weight unpack of superblock b, once for the YB activation groups
+                int8x16_t w_q[QK_K / 64][8][4];  // [sb][k][0123 lo, 0123 hi, 4567 lo, 4567 hi]
+                int16x8_t w_sc[QK_K / 64][2];
+                int16x8_t w_mins[QK_K / 64][2];
+                uint8x16_t qh[2][8];
+                if constexpr (IS_Q5) {
+                    const uint8_t * qh_base = ((const block_q5_Kx8 *) vx + (x * nb) + b)->qh;
+                    for (int i = 0; i < 2; i++) {
+                        for (int j = 0; j < 8; j++) {
+                            qh[i][j] = vld1q_u8(qh_base + i * 16 + j * 32);
+                        }
+                    }
+                }
+                for (int sb = 0; sb < QK_K / 64; sb++) {
+                    for (int i = 0; i < 2; i++) {
+                        int8_t aux[8];
+                        decode_q_Kx8_6bit_scales(w_scales + sb * 24 + i * 12, &w_mins[sb][i], aux);
+                        w_sc[sb][i] = vmovl_s8(vld1_s8(aux));
+                    }
+                    for (int k = 0; k < 8; k++) {
+                        const uint8x16_t q0123 = vld1q_u8(w_qs + sb * QK_K + 32 * k);
+                        const uint8x16_t q4567 = vld1q_u8(w_qs + sb * QK_K + 32 * k + 16);
+                        if constexpr (IS_Q5) {
+                            const uint8x16_t hbit_lo_0123 = vandq_u8(qh[0][k], mone);
+                            const uint8x16_t hbit_hi_0123 = vshlq_n_u8(vandq_u8(qh[0][k], mtwo), 3);
+                            qh[0][k]                      = vshrq_n_u8(qh[0][k], 2);
+                            const uint8x16_t hbit_lo_4567 = vandq_u8(qh[1][k], mone);
+                            const uint8x16_t hbit_hi_4567 = vshlq_n_u8(vandq_u8(qh[1][k], mtwo), 3);
+                            qh[1][k]                      = vshrq_n_u8(qh[1][k], 2);
+                            w_q[sb][k][0] = vreinterpretq_s8_u8(vsliq_n_u8(vandq_u8(q0123, m4b), hbit_lo_0123, 4));
+                            w_q[sb][k][1] = vreinterpretq_s8_u8(vorrq_u8(vshrq_n_u8(q0123, 4), hbit_hi_0123));
+                            w_q[sb][k][2] = vreinterpretq_s8_u8(vsliq_n_u8(vandq_u8(q4567, m4b), hbit_lo_4567, 4));
+                            w_q[sb][k][3] = vreinterpretq_s8_u8(vorrq_u8(vshrq_n_u8(q4567, 4), hbit_hi_4567));
+                        } else {
+                            w_q[sb][k][0] = vreinterpretq_s8_u8(vandq_u8(q0123, m4b));
+                            w_q[sb][k][1] = vreinterpretq_s8_u8(vshrq_n_u8(q0123, 4));
+                            w_q[sb][k][2] = vreinterpretq_s8_u8(vandq_u8(q4567, m4b));
+                            w_q[sb][k][3] = vreinterpretq_s8_u8(vshrq_n_u8(q4567, 4));
+                        }
+                    }
+                }
+
+                for (int yy = 0; yy < yn; yy++) {
+                    const block_q8_Kx4 * GGML_RESTRICT q8_ptr = (const block_q8_Kx4 *) vy + ((y0 + yy) * nb);
+                    const float32x4_t q8_d_0123 = vld1q_f32(q8_ptr[b].d);
+                    float32x4_t sbd_scale_0123[q8_k_blocklen];
+                    float32x4_t sbd_scale_4567[q8_k_blocklen];
+                    float32x4_t sbd_min_0123[q8_k_blocklen];
+                    float32x4_t sbd_min_4567[q8_k_blocklen];
+                    sbd_scale_0123[0] = vmulq_laneq_f32(w_d_0123, q8_d_0123, 0);
+                    sbd_scale_4567[0] = vmulq_laneq_f32(w_d_4567, q8_d_0123, 0);
+                    sbd_min_0123[0]   = vmulq_laneq_f32(w_dmin_0123, q8_d_0123, 0);
+                    sbd_min_4567[0]   = vmulq_laneq_f32(w_dmin_4567, q8_d_0123, 0);
+                    sbd_scale_0123[1] = vmulq_laneq_f32(w_d_0123, q8_d_0123, 1);
+                    sbd_scale_4567[1] = vmulq_laneq_f32(w_d_4567, q8_d_0123, 1);
+                    sbd_min_0123[1]   = vmulq_laneq_f32(w_dmin_0123, q8_d_0123, 1);
+                    sbd_min_4567[1]   = vmulq_laneq_f32(w_dmin_4567, q8_d_0123, 1);
+                    sbd_scale_0123[2] = vmulq_laneq_f32(w_d_0123, q8_d_0123, 2);
+                    sbd_scale_4567[2] = vmulq_laneq_f32(w_d_4567, q8_d_0123, 2);
+                    sbd_min_0123[2]   = vmulq_laneq_f32(w_dmin_0123, q8_d_0123, 2);
+                    sbd_min_4567[2]   = vmulq_laneq_f32(w_dmin_4567, q8_d_0123, 2);
+                    sbd_scale_0123[3] = vmulq_laneq_f32(w_d_0123, q8_d_0123, 3);
+                    sbd_scale_4567[3] = vmulq_laneq_f32(w_d_4567, q8_d_0123, 3);
+                    sbd_min_0123[3]   = vmulq_laneq_f32(w_dmin_0123, q8_d_0123, 3);
+                    sbd_min_4567[3]   = vmulq_laneq_f32(w_dmin_4567, q8_d_0123, 3);
+
+                    const int16x8_t bsums[q8_k_blocklen] = {
+                        vpaddq_s16(vld1q_s16(q8_ptr[b].bsums + 16 * 0), vld1q_s16(q8_ptr[b].bsums + 16 * 0 + 8)),
+                        vpaddq_s16(vld1q_s16(q8_ptr[b].bsums + 16 * 1), vld1q_s16(q8_ptr[b].bsums + 16 * 1 + 8)),
+                        vpaddq_s16(vld1q_s16(q8_ptr[b].bsums + 16 * 2), vld1q_s16(q8_ptr[b].bsums + 16 * 2 + 8)),
+                        vpaddq_s16(vld1q_s16(q8_ptr[b].bsums + 16 * 3), vld1q_s16(q8_ptr[b].bsums + 16 * 3 + 8)),
+                    };
+                    int16_t bsums_arr[QK_K / 64][8];
+                    for (int q8_row = 0; q8_row < 4; q8_row++) {
+                        vst1q_s16(bsums_arr[q8_row], bsums[q8_row]);
+                    }
+
+                    int32x4_t bias_acc[acc_size];
+                    for (int i = 0; i < acc_size; i++) {
+                        bias_acc[i] = vdupq_n_s32(0);
+                    }
+
+                    for (int sb = 0; sb < QK_K / 64; sb++) {
+                        int32x4_t acc_lo[acc_size];
+                        int32x4_t acc_hi[acc_size];
+                        for (int i = 0; i < acc_size; i++) {
+                            acc_lo[i] = vdupq_n_s32(0);
+                            acc_hi[i] = vdupq_n_s32(0);
+                        }
+                        for (int k = 0; k < 8; k++) {
+                            const int8x16_t q8_blk0 = vld1q_s8(q8_ptr[b].qs + sb * 256 + 16 * k);
+                            const int8x16_t q8_blk1 = vld1q_s8(q8_ptr[b].qs + sb * 256 + 16 * k + 128);
+                            const int8x16_t * w     = w_q[sb][k];
+                            acc_lo[0] = vdotq_laneq_s32(acc_lo[0], w[0], q8_blk0, 0);
+                            acc_lo[1] = vdotq_laneq_s32(acc_lo[1], w[0], q8_blk0, 1);
+                            acc_lo[2] = vdotq_laneq_s32(acc_lo[2], w[0], q8_blk0, 2);
+                            acc_lo[3] = vdotq_laneq_s32(acc_lo[3], w[0], q8_blk0, 3);
+                            acc_hi[0] = vdotq_laneq_s32(acc_hi[0], w[1], q8_blk1, 0);
+                            acc_hi[1] = vdotq_laneq_s32(acc_hi[1], w[1], q8_blk1, 1);
+                            acc_hi[2] = vdotq_laneq_s32(acc_hi[2], w[1], q8_blk1, 2);
+                            acc_hi[3] = vdotq_laneq_s32(acc_hi[3], w[1], q8_blk1, 3);
+                            acc_lo[4] = vdotq_laneq_s32(acc_lo[4], w[2], q8_blk0, 0);
+                            acc_lo[5] = vdotq_laneq_s32(acc_lo[5], w[2], q8_blk0, 1);
+                            acc_lo[6] = vdotq_laneq_s32(acc_lo[6], w[2], q8_blk0, 2);
+                            acc_lo[7] = vdotq_laneq_s32(acc_lo[7], w[2], q8_blk0, 3);
+                            acc_hi[4] = vdotq_laneq_s32(acc_hi[4], w[3], q8_blk1, 0);
+                            acc_hi[5] = vdotq_laneq_s32(acc_hi[5], w[3], q8_blk1, 1);
+                            acc_hi[6] = vdotq_laneq_s32(acc_hi[6], w[3], q8_blk1, 2);
+                            acc_hi[7] = vdotq_laneq_s32(acc_hi[7], w[3], q8_blk1, 3);
+                        }
+
+                        const int16x4_t sc_0123_lo = vget_low_s16(w_sc[sb][0]);
+                        const int16x4_t sc_4567_lo = vget_high_s16(w_sc[sb][0]);
+                        const int16x4_t sc_0123_hi = vget_low_s16(w_sc[sb][1]);
+                        const int16x4_t sc_4567_hi = vget_high_s16(w_sc[sb][1]);
+                        for (int row = 0; row < q8_k_blocklen; row++) {
+                            const float32x4_t sumf_0123 =
+                                vcvtq_f32_s32(vaddq_s32(vmulq_s32(vmovl_s16(sc_0123_lo), acc_lo[row]),
+                                                        vmulq_s32(vmovl_s16(sc_0123_hi), acc_hi[row])));
+                            acc_f32[yy][2 * row] = vfmaq_f32(acc_f32[yy][2 * row], sbd_scale_0123[row], sumf_0123);
+                            const float32x4_t sumf_4567 =
+                                vcvtq_f32_s32(vaddq_s32(vmulq_s32(vmovl_s16(sc_4567_lo), acc_lo[row + 4]),
+                                                        vmulq_s32(vmovl_s16(sc_4567_hi), acc_hi[row + 4])));
+                            acc_f32[yy][2 * row + 1] = vfmaq_f32(acc_f32[yy][2 * row + 1], sbd_scale_4567[row], sumf_4567);
+
+                            const int16x4_t bsums_vec_lo = vdup_n_s16(bsums_arr[sb][row * 2]);
+                            const int16x4_t bsums_vec_hi = vdup_n_s16(bsums_arr[sb][row * 2 + 1]);
+                            bias_acc[2 * row] = vmlal_s16(bias_acc[2 * row], bsums_vec_lo, vget_low_s16(w_mins[sb][0]));
+                            bias_acc[2 * row] = vmlal_s16(bias_acc[2 * row], bsums_vec_hi, vget_low_s16(w_mins[sb][1]));
+                            bias_acc[2 * row + 1] =
+                                vmlal_s16(bias_acc[2 * row + 1], bsums_vec_lo, vget_high_s16(w_mins[sb][0]));
+                            bias_acc[2 * row + 1] =
+                                vmlal_s16(bias_acc[2 * row + 1], bsums_vec_hi, vget_high_s16(w_mins[sb][1]));
+                        }
+                    }
+
+                    for (int row = 0; row < q8_k_blocklen; row++) {
+                        acc_f32[yy][2 * row] =
+                            vmlsq_f32(acc_f32[yy][2 * row], vcvtq_f32_s32(bias_acc[2 * row]), sbd_min_0123[row]);
+                        acc_f32[yy][2 * row + 1] =
+                            vmlsq_f32(acc_f32[yy][2 * row + 1], vcvtq_f32_s32(bias_acc[2 * row + 1]), sbd_min_4567[row]);
+                    }
+                }
+            }
+
+            for (int yy = 0; yy < yn; yy++) {
+                for (int i = 0; i < q8_k_blocklen; i++) {
+                    const int row = (y0 + yy) * q8_k_blocklen + i;
+                    for (int j = 0; j < 2; j++) {
+                        vst1q_f32(s + row * bs + x * ncols_interleaved + j * 4, acc_f32[yy][2 * i + j]);
+                    }
+                }
+            }
+        }
+    }
+}
