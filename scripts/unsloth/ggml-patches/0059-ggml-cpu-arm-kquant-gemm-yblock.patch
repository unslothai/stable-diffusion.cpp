+// dotprod 8x4 Q6_K
+template <int YB>
+static void ggml_gemm_q6_K_8x4_q8_K_yb(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                                       const void * GGML_RESTRICT vy, int nr, int nc) {
+    constexpr int ncols_interleaved = 8;
+    constexpr int q8_k_blocklen     = 4;
+    constexpr int col_groups        = ncols_interleaved / 4;
+    constexpr int acc_size          = q8_k_blocklen * col_groups;
+    const int     nb                = n / QK_K;
+    const int     ny                = nr / q8_k_blocklen;
+    const uint8x16_t m4b            = vdupq_n_u8(0x0f);
+    const uint8x16_t mask_lo        = vdupq_n_u8(0x03);
+    const uint8x16_t mask_hi        = vdupq_n_u8(0x30);
+    const int8x16_t  m32s           = vdupq_n_s8(32);
+
+    for (int y0 = 0; y0 < ny; y0 += YB) {
+        const int yn = ny - y0 < YB ? ny - y0 : YB;
+        for (int x = 0; x < nc / ncols_interleaved; x++) {
+            const block_q6_Kx8 * GGML_RESTRICT q6_ptr = (const block_q6_Kx8 *) vx + (x * nb);
+            float32x4_t acc_f32[YB][acc_size];
+            for (int yy = 0; yy < YB; yy++) {
+                for (int i = 0; i < acc_size; i++) {
+                    acc_f32[yy][i] = vdupq_n_f32(0);
+                }
+            }
+
+            for (int b = 0; b < nb; b++) {
+                const float32x4_t q6_d_0123 = vcvt_f32_f16(vld1_f16((const __fp16 *) q6_ptr[b].d));
+                const float32x4_t q6_d_4567 = vcvt_f32_f16(vld1_f16((const __fp16 *) q6_ptr[b].d + 4));
+
+                int16_t q6_scales[8 * 16];
+                for (int i = 0; i < 16; i++) {
+                    vst1q_s16(q6_scales + i * 8, vmovl_s8(vld1_s8(q6_ptr[b].scales + i * 8)));
+                }
+                int8x16_t w_q[2][QK_K / 64][4][4];  // [half][sb][k][0123 lo, 0123 hi, 4567 lo, 4567 hi]
+                for (int half = 0; half < 2; half++) {
+                    const uint8_t * ql_base = q6_ptr[b].ql + half * 512;
+                    const uint8_t * qh_base = q6_ptr[b].qh + half * 256;
+                    for (int sb = 0; sb < QK_K / 64; sb++) {
+                        const int ql_off_base = sb * QK_K / 2;
+                        const int qh_off_base = ql_off_base & 255;
+                        for (int k = 0; k < 4; k++) {
+                            const uint8x16_t ql_0123 = vld1q_u8(ql_base + ql_off_base + k * 32);
+                            const uint8x16_t ql_4567 = vld1q_u8(ql_base + ql_off_base + k * 32 + 16);
+                            uint8x16_t       qh_0123 = vld1q_u8(qh_base + qh_off_base + k * 32);
+                            uint8x16_t       qh_4567 = vld1q_u8(qh_base + qh_off_base + k * 32 + 16);
+                            if (sb > 1) {
+                                qh_0123 = vshrq_n_u8(qh_0123, 2);
+                                qh_4567 = vshrq_n_u8(qh_4567, 2);
+                            }
+                            const uint8x16_t hbit_lo_0123 = vandq_u8(qh_0123, mask_lo);
+                            const uint8x16_t hbit_hi_0123 = vandq_u8(qh_0123, mask_hi);
+                            const uint8x16_t hbit_lo_4567 = vandq_u8(qh_4567, mask_lo);
+                            const uint8x16_t hbit_hi_4567 = vandq_u8(qh_4567, mask_hi);
+                            w_q[half][sb][k][0] = vsubq_s8(
+                                vreinterpretq_s8_u8(vsliq_n_u8(vandq_u8(ql_0123, m4b), hbit_lo_0123, 4)), m32s);
+                            w_q[half][sb][k][1] = vsubq_s8(
+                                vreinterpretq_s8_u8(vorrq_u8(vshrq_n_u8(ql_0123, 4), hbit_hi_0123)), m32s);
+                            w_q[half][sb][k][2] = vsubq_s8(
+                                vreinterpretq_s8_u8(vsliq_n_u8(vandq_u8(ql_4567, m4b), hbit_lo_4567, 4)), m32s);
+                            w_q[half][sb][k][3] = vsubq_s8(
+                                vreinterpretq_s8_u8(vorrq_u8(vshrq_n_u8(ql_4567, 4), hbit_hi_4567)), m32s);
+                        }
+                    }
+                }
+
+                for (int yy = 0; yy < yn; yy++) {
+                    const block_q8_Kx4 * GGML_RESTRICT q8_ptr = (const block_q8_Kx4 *) vy + ((y0 + yy) * nb);
+                    const float32x4_t q8_d_0123 = vld1q_f32(q8_ptr[b].d);
+                    float32x4_t sbd_scale_0123[q8_k_blocklen];
+                    float32x4_t sbd_scale_4567[q8_k_blocklen];
+                    sbd_scale_0123[0] = vmulq_laneq_f32(q6_d_0123, q8_d_0123, 0);
+                    sbd_scale_4567[0] = vmulq_laneq_f32(q6_d_4567, q8_d_0123, 0);
+                    sbd_scale_0123[1] = vmulq_laneq_f32(q6_d_0123, q8_d_0123, 1);
+                    sbd_scale_4567[1] = vmulq_laneq_f32(q6_d_4567, q8_d_0123, 1);
+                    sbd_scale_0123[2] = vmulq_laneq_f32(q6_d_0123, q8_d_0123, 2);
+                    sbd_scale_4567[2] = vmulq_laneq_f32(q6_d_4567, q8_d_0123, 2);
+                    sbd_scale_0123[3] = vmulq_laneq_f32(q6_d_0123, q8_d_0123, 3);
+                    sbd_scale_4567[3] = vmulq_laneq_f32(q6_d_4567, q8_d_0123, 3);
+
+                    int32x4_t acc_s32[acc_size];
+                    for (int i = 0; i < acc_size; i++) {
+                        acc_s32[i] = vdupq_n_s32(0);
+                    }
+
+                    for (int half = 0; half < 2; half++) {
+                        for (int sb = 0; sb < QK_K / 64; sb++) {
+                            int32x4_t acc_lo[acc_size];
+                            int32x4_t acc_hi[acc_size];
+                            for (int i = 0; i < acc_size; i++) {
+                                acc_lo[i] = vdupq_n_s32(0);
+                                acc_hi[i] = vdupq_n_s32(0);
+                            }
+                            const int8_t * q8_base_l = q8_ptr[b].qs + half * 512 + sb * 64;
+                            const int8_t * q8_base_h = q8_ptr[b].qs + half * 512 + 256 + sb * 64;
+                            for (int k = 0; k < 4; k++) {
+                                const int8x16_t q8_l = vld1q_s8(q8_base_l + 16 * k);
+                                const int8x16_t q8_h = vld1q_s8(q8_base_h + 16 * k);
+                                const int8x16_t * w  = w_q[half][sb][k];
+                                acc_lo[0] = vdotq_laneq_s32(acc_lo[0], w[0], q8_l, 0);
+                                acc_lo[1] = vdotq_laneq_s32(acc_lo[1], w[0], q8_l, 1);
+                                acc_lo[2] = vdotq_laneq_s32(acc_lo[2], w[0], q8_l, 2);
+                                acc_lo[3] = vdotq_laneq_s32(acc_lo[3], w[0], q8_l, 3);
+                                acc_hi[0] = vdotq_laneq_s32(acc_hi[0], w[1], q8_h, 0);
+                                acc_hi[1] = vdotq_laneq_s32(acc_hi[1], w[1], q8_h, 1);
+                                acc_hi[2] = vdotq_laneq_s32(acc_hi[2], w[1], q8_h, 2);
+                                acc_hi[3] = vdotq_laneq_s32(acc_hi[3], w[1], q8_h, 3);
+                                acc_lo[4] = vdotq_laneq_s32(acc_lo[4], w[2], q8_l, 0);
+                                acc_lo[5] = vdotq_laneq_s32(acc_lo[5], w[2], q8_l, 1);
+                                acc_lo[6] = vdotq_laneq_s32(acc_lo[6], w[2], q8_l, 2);
+                                acc_lo[7] = vdotq_laneq_s32(acc_lo[7], w[2], q8_l, 3);
+                                acc_hi[4] = vdotq_laneq_s32(acc_hi[4], w[3], q8_h, 0);
+                                acc_hi[5] = vdotq_laneq_s32(acc_hi[5], w[3], q8_h, 1);
+                                acc_hi[6] = vdotq_laneq_s32(acc_hi[6], w[3], q8_h, 2);
+                                acc_hi[7] = vdotq_laneq_s32(acc_hi[7], w[3], q8_h, 3);
+                            }
+                            const int scale_idx_l = half * 8 + sb;
+                            const int scale_idx_h = half * 8 + sb + 4;
+                            for (int g = 0; g < col_groups; g++) {
+                                const int32x4_t scale_vec_l = vmovl_s16(vld1_s16(q6_scales + scale_idx_l * 8 + g * 4));
+                                const int32x4_t scale_vec_h = vmovl_s16(vld1_s16(q6_scales + scale_idx_h * 8 + g * 4));
+                                const int       acc_offset  = g * q8_k_blocklen;
+                                for (int row = 0; row < q8_k_blocklen; row++) {
+                                    const int idx = row * 2 + g;
+                                    acc_s32[idx]  = vmlaq_s32(acc_s32[idx], acc_lo[acc_offset + row], scale_vec_l);
+                                    acc_s32[idx]  = vmlaq_s32(acc_s32[idx], acc_hi[acc_offset + row], scale_vec_h);
+                                }
+                            }
+                        }
+                    }
+
+                    for (int row = 0; row < q8_k_blocklen; row++) {
+                        const int idx0 = 2 * row;
+                        const int idx1 = 2 * row + 1;
+                        acc_f32[yy][idx0] = vmlaq_f32(acc_f32[yy][idx0], vcvtq_f32_s32(acc_s32[idx0]), sbd_scale_0123[row]);
+                        acc_f32[yy][idx1] = vmlaq_f32(acc_f32[yy][idx1], vcvtq_f32_s32(acc_s32[idx1]), sbd_scale_4567[row]);
+                    }
+                }
+            }
+
+            for (int yy = 0; yy < yn; yy++) {
+                for (int i = 0; i < q8_k_blocklen; i++) {
+                    const int row = (y0 + yy) * q8_k_blocklen + i;
+                    for (int j = 0; j < 2; j++) {
+                        vst1q_f32(s + row * bs + x * ncols_interleaved + j * 4, acc_f32[yy][2 * i + j]);
+                    }
+                }
+            }
+        }
+    }
+}
