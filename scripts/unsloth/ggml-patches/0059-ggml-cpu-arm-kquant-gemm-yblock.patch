+GGML_KQ_YB_DISPATCH(ggml_gemm_q4_K_8x8_q8_K, "q4_K 8x8")
+GGML_KQ_YB_DISPATCH(ggml_gemm_q5_K_8x8_q8_K, "q5_K 8x8")
+GGML_KQ_YB_DISPATCH(ggml_gemm_q6_K_8x8_q8_K, "q6_K 8x8")
+#endif  // i8mm
