+// Fully contiguous inputs: concat along any dim < 3 is, per outer index, one slab of x then one of y.
+// One launch for every i3, where the per-i3 loop below launches ne3 kernels (thousands for a VAE's channels).
+template <typename T>
+static __global__ void __launch_bounds__(CUDA_CONCAT_BLOCK_SIZE) concat_slabs(const T * x,
+                                                                              const T * y,
+                                                                              T *       dst,
+                                                                              int64_t   slab0,
+                                                                              int64_t   slab,
+                                                                              int64_t   n) {
+    ggml_cuda_pdl_sync();
+    const int64_t slab1 = slab - slab0;
+    for (int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; i < n; i += (int64_t) blockDim.x * gridDim.x) {
+        const int64_t o = i / slab;
+        const int64_t r = i - o * slab;
+        dst[i] = r < slab0 ? x[o * slab0 + r] : y[o * slab1 + (r - slab0)];
+    }
+}
