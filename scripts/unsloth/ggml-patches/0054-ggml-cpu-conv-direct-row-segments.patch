+// Max source elements of one converted row segment (see conv_patch_row): (CONV_2D_RUN - 1) * stride + (knl - 1) * dilation + 1.
+#define CONV_SEG_MAX 1024
+
+// im2col of one (input plane, kernel row) for a run of `run` consecutive patches of one output row: the source row
+// segment the run reads ([x0, x0 + seg_n), zero outside the row or when src_row is null) is converted once, then each
+// patch copies its knl_w taps from it. The per-tap loop converted every source element knl_w times and handled one
+// patch element per store; the values written, and their slots, are the same. The per-tap loop stays for 1-wide
+// kernels (nothing is converted twice there), for segments longer than CONV_SEG_MAX and as the reference path
+// (use_ref, what test-backend-ops -b CPU compares against).
+template <typename T>
+static inline void conv_patch_row(char * dst_base, int64_t dst_stride, const char * src_row, int64_t src_nb0, int64_t src_w,
+                                  int64_t x0, int64_t run, int64_t stride, int64_t dilation, int64_t knl_w, T * seg) {
+    const int64_t seg_n = (run - 1) * stride + (knl_w - 1) * dilation + 1;
+    const int64_t lo    = std::min<int64_t>(seg_n, std::max<int64_t>(0, -x0));        // first in-row element of the segment
+    const int64_t hi    = std::max<int64_t>(lo, std::min<int64_t>(seg_n, src_w - x0));  // one past the last
+    if (src_row == nullptr) {
+        for (int64_t t = 0; t < seg_n; ++t) { seg[t] = T(); }
+    } else {
+        for (int64_t t = 0; t < lo; ++t) { seg[t] = T(); }
+        if constexpr (std::is_same_v<T, float>) {
+            for (int64_t t = lo; t < hi; ++t) { seg[t] = *(const float *) (src_row + (x0 + t) * src_nb0); }
+        } else if (src_nb0 == (int64_t) sizeof(float)) {
+            ggml_cpu_fp32_to_fp16((const float *) src_row + x0 + lo, seg + lo, hi - lo);
+        } else {
+            for (int64_t t = lo; t < hi; ++t) { seg[t] = GGML_CPU_FP32_TO_FP16(*(const float *) (src_row + (x0 + t) * src_nb0)); }
+        }
+        for (int64_t t = hi; t < seg_n; ++t) { seg[t] = T(); }
+    }
+    for (int64_t j = 0; j < run; ++j) {
+        T *       d = (T *) (dst_base + j * dst_stride);
+        const T * s = seg + j * stride;
+        for (int64_t kx = 0; kx < knl_w; ++kx) {
+            d[kx] = s[kx * dilation];
+        }
+    }
+}
