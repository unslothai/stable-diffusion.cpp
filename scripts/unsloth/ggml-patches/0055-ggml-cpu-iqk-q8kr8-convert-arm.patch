 bool iqk_set_kernels_kquants(int typeA, mul_mat_t * kernels) {
     switch (typeA) {
         case GGML_TYPE_Q2_K:   IQK_SET_MUL_MAT_FUNCTIONS_T(mul_mat_qX_K_q8_K_T, DequantizerQ2K,   kernels); break;
