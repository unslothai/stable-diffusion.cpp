From 8fc9c08eca32a4ed59aaccdb26a8972f54ca227d Mon Sep 17 00:00:00 2001
From: Daniel Han <danielhanchen@gmail.com>
Date: Sat, 7 Nov 2026 17:33:01 -0800
Subject: [PATCH] ggml-hip: FP32 softmax(KQ)*V accumulators in the tile
 FlashAttention kernel

On HIP, FAST_FP16_AVAILABLE makes the tile kernel keep its VKQ accumulators
in half2. They hold the unnormalised sum of up to ne11 rows of V and are only
divided by KQ_sum at the end, so for long KV sequences they pass 65504 and
become inf: GGML_PREC_F32 is ignored. HIP picks the tile kernel for every
unmasked attention without GQA (diffusion transformers), so at 10^5 tokens
whole output tokens go to inf/NaN and then to black.

Keep Q, K, V and KQ in FP16 and only the VKQ accumulators in FP32. When the
partial results of several warps per column are combined, each warp writes
its partial divided by its own KQ sum (bounded by max |V|) to the FP16 shared
buffer and the leader warp scales it back in FP32. NVIDIA is unchanged.
---
 src/ggml-cuda/fattn-tile.cuh | 42 ++++++++++++++++++++++++++++++++++--
 1 file changed, 40 insertions(+), 2 deletions(-)

diff --git a/src/ggml-cuda/fattn-tile.cuh b/src/ggml-cuda/fattn-tile.cuh
index b5ea915..6a11018 100644
--- a/src/ggml-cuda/fattn-tile.cuh
+++ b/src/ggml-cuda/fattn-tile.cuh
@@ -7,6 +7,13 @@
 // TODO optimize kernel parameters for FP16 NVIDIA (P100)
 // TODO optimize kernel parameters for head sizes 40, 72, 80, 96, 112
 
+// On HIP the FP16 tile kernel keeps the softmax(KQ)*V accumulators (VKQ) in FP32: they sum up to ne11 rows of V
+// before the final 1/KQ_sum, so FP16 accumulators overflow to inf for long KV sequences (diffusion transformers at
+// 10^5 tokens), and HIP selects this kernel for every unmasked attention without GQA. K, Q, V and KQ stay FP16.
+#if defined(FAST_FP16_AVAILABLE) && defined(GGML_USE_HIP)
+#define GGML_CUDA_FATTN_TILE_VKQ_F32
+#endif // defined(FAST_FP16_AVAILABLE) && defined(GGML_USE_HIP)
+
 // The ROCm compiler cannot handle templating in __launch_bounds__.
 // As a workaround, define a macro to package the kernel parameters as uint32_t:
 #define GGML_CUDA_FATTN_TILE_CONFIG_CASE(DKQ_, DV_, ncols_, nthreads, occupancy, nbatch_fa, nbatch_K) \
@@ -685,7 +692,7 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
             }
             KQ_sum[jc] = KQ_sum[jc]*KQ_max_scale + KQ_sum_add;
 
-#ifdef FAST_FP16_AVAILABLE
+#if defined(FAST_FP16_AVAILABLE) && !defined(GGML_CUDA_FATTN_TILE_VKQ_F32)
             const half2 KQ_max_scale_h2 = make_half2(KQ_max_scale, KQ_max_scale);
 #pragma unroll
             for (int i0 = 0; i0 < DVp/2; i0 += warp_size) {
@@ -750,7 +757,14 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
             for (int i0 = 0; i0 < DVp/2; i0 += warp_size) {
 #pragma unroll
                 for (int jc_VKQ_0 = 0; jc_VKQ_0 < cpw; ++jc_VKQ_0) {
+#ifdef GGML_CUDA_FATTN_TILE_VKQ_F32
+                    const float2 V_f2 = __half22float2(V_k[i0/warp_size]);
+                    const float  KQ_f = __low2float(KQ_k[jc_VKQ_0]);
+                    VKQ[jc_VKQ_0*((DVp/2)/warp_size) + i0/warp_size].x += V_f2.x*KQ_f;
+                    VKQ[jc_VKQ_0*((DVp/2)/warp_size) + i0/warp_size].y += V_f2.y*KQ_f;
+#else
                     VKQ[jc_VKQ_0*((DVp/2)/warp_size) + i0/warp_size] += V_k[i0/warp_size]*KQ_k[jc_VKQ_0];
+#endif // GGML_CUDA_FATTN_TILE_VKQ_F32
                 }
             }
         }
@@ -885,7 +899,11 @@ static __global__ void flash_attn_tile(
     __shared__ half2 Q_tmp[ncols * DKQ/2];
     __shared__ half2 KV_tmp[nbatch_fa * (nbatch_K/2 + cpy_ne) + DVp-DV];
     __shared__ half  KQ[ncols * nbatch_fa];
+#ifdef GGML_CUDA_FATTN_TILE_VKQ_F32
+    __align__(16) float2 VKQ[cpw * ((DVp/2)/warp_size)] = {{0.0f, 0.0f}};
+#else
     __align__(16) half2 VKQ[cpw * ((DVp/2)/warp_size)] = {{0.0f, 0.0f}};
+#endif // GGML_CUDA_FATTN_TILE_VKQ_F32
 #else
     __shared__ float Q_tmp[ncols * DKQ];
     __shared__ float KV_tmp[nbatch_fa * (nbatch_K + cpy_ne) + DVp-DV];
@@ -999,7 +1017,17 @@ static __global__ void flash_attn_tile(
             constexpr int cpy_ne_D = cpy_ne < (DVp/2)/warp_size ? cpy_ne : (DVp/2)/warp_size;
 #pragma unroll
             for (int i0 = 0; i0 < DVp/2; i0 += warp_size*cpy_ne_D) {
+#ifdef GGML_CUDA_FATTN_TILE_VKQ_F32
+                const float inv_sum = KQ_sum[0] > 0.0f ? 1.0f/KQ_sum[0] : 0.0f;
+                __align__(16) half2 tmp[cpy_ne_D];
+#pragma unroll
+                for (int i1 = 0; i1 < cpy_ne_D; ++i1) {
+                    tmp[i1] = make_half2(VKQ[i0/warp_size + i1].x*inv_sum, VKQ[i0/warp_size + i1].y*inv_sum);
+                }
+                ggml_cuda_memcpy_1<cpy_ne_D*4>(&VKQ_combine[threadIdx.y*(DVp/2) + i0 + threadIdx.x*cpy_ne_D], tmp);
+#else
                 ggml_cuda_memcpy_1<cpy_ne_D*4>(&VKQ_combine[threadIdx.y*(DVp/2) + i0 + threadIdx.x*cpy_ne_D], &VKQ[i0/warp_size]);
+#endif // GGML_CUDA_FATTN_TILE_VKQ_F32
             }
 #else
             constexpr int cpy_ne_D = cpy_ne < DVp/warp_size ? cpy_ne : DVp/warp_size;
@@ -1029,7 +1057,13 @@ static __global__ void flash_attn_tile(
                 ggml_cuda_memcpy_1<cpy_ne_D*4>(tmp, &VKQ_combine[(threadIdx.y + ip)*(DVp/2) + i0 + threadIdx.x*cpy_ne_D]);
 #pragma unroll
                 for (int i1 = 0; i1 < cpy_ne_D; ++i1) {
+#ifdef GGML_CUDA_FATTN_TILE_VKQ_F32
+                    const float2 tmp_f2 = __half22float2(tmp[i1]);
+                    VKQ[i0/warp_size + i1].x += tmp_f2.x*KQ_sum_combine[threadIdx.y + ip];
+                    VKQ[i0/warp_size + i1].y += tmp_f2.y*KQ_sum_combine[threadIdx.y + ip];
+#else
                     VKQ[i0/warp_size + i1] += tmp[i1];
+#endif // GGML_CUDA_FATTN_TILE_VKQ_F32
                 }
             }
 #else
@@ -1063,7 +1097,7 @@ static __global__ void flash_attn_tile(
             const float val = expf(sink - KQ_max[jc0]);
             KQ_sum[jc0] = KQ_sum[jc0]*KQ_max_scale + val;
 
-#ifdef FAST_FP16_AVAILABLE
+#if defined(FAST_FP16_AVAILABLE) && !defined(GGML_CUDA_FATTN_TILE_VKQ_F32)
             const half2 KQ_max_scale_h2 = make_half2(KQ_max_scale, KQ_max_scale);
 #pragma unroll
             for (int i0 = 0; i0 < DVp/2; i0 += warp_size) {
@@ -1102,7 +1136,11 @@ static __global__ void flash_attn_tile(
             __align__(16) float2 tmp[cpy_ne_D];
 #pragma unroll
             for (int i1 = 0; i1 < cpy_ne_D; ++i1) {
+#ifdef GGML_CUDA_FATTN_TILE_VKQ_F32
+                tmp[i1] = VKQ[jc0*((DVp/2)/warp_size) + i0/warp_size + i1];
+#else
                 tmp[i1] = __half22float2(VKQ[jc0*((DVp/2)/warp_size) + i0/warp_size + i1]);
+#endif // GGML_CUDA_FATTN_TILE_VKQ_F32
                 tmp[i1].x *= scale;
                 tmp[i1].y *= scale;
             }
-- 
