+++ b/src/ggml-vulkan/vulkan-shaders/rms_norm.comp
@@ -39,7 +39,11 @@ layout (binding = 3) readonly buffer I {uvec2 data_i[];};
 #endif
 
 #extension GL_EXT_control_flow_attributes : enable
+// Rows of at most 128 elements (per-head QK norms) use a 128-thread variant: each thread still holds at most one
+// element and the tree below only drops the steps that added zeros, so the result is bit-identical to 512 threads.
+#ifndef BLOCK_SIZE
 #define BLOCK_SIZE 512
+#endif
 
 layout (constant_id = 1) const bool do_multiply = false;
 #if RMS_NORM_ADD_FUSION
