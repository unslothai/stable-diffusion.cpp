+static inline __m128i load_iq4nl_values_128() {
+    // kvalues_iq4nl + 128
+    static const uint8_t k_values[16] = {1, 24, 45, 63, 79, 93, 106, 118, 129, 141, 153, 166, 181, 197, 217, 241};
+    return _mm_loadu_si128((const __m128i *)k_values);
+}
+
+static inline __m256i load_iq4nl_values_256() {
+    auto val128 = load_iq4nl_values_128();
+    return MM256_SET1_M128I(val128);
+}
