index 0000000..1899fd7
--- /dev/null
+++ b/src/ggml-cpu/iqk/iqk_gemm.cpp
@@ -0,0 +1,258 @@
+//
+// Copyright (C) 2024-2025 Iwan Kawrakow
+// MIT license
+// SPDX-License-Identifier: MIT
+//
+// Adapted from ik_llama.cpp (https://github.com/ikawrakow/ik_llama.cpp) commit 009dce19,
+// ggml/src/iqk/{iqk_config.h, iqk_common.h, iqk_gemm_kquants.cpp, iqk_gemm_iquants.cpp, iqk_gemm_1bit.cpp, iqk_mul_mat.cpp}.
+// Only the kernels that read the upstream ggml block layouts with upstream Q8_K activations are kept.
+//
+// Permission is hereby granted, free of charge, to any person obtaining a copy
+// of this software and associated documentation files (the "Software"), to deal
+// in the Software without restriction, including without limitation the rights
+// to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+// copies of the Software, and to permit persons to whom the Software is
+// furnished to do so, subject to the following conditions:
+//
+// The above copyright notice and this permission notice shall be included in all
+// copies or substantial portions of the Software.
+//
+// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+// IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+// AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+// LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+// OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+// SOFTWARE.
+//
+// Driver of the iqk GEMM kernels (the tiling of MulMat::mul_mat_NxM in iqk_mul_mat.cpp).
+
+#include "iqk_gemm.h"
+#include "iqk_common.h"
+
+#include "ggml.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+
+// the types this file can serve (whether or not this CPU variant has kernels for them)
+constexpr uint64_t iqk_type_bit(ggml_type t) { return 1ull << (int) t; }
+[[maybe_unused]] constexpr uint64_t k_iqk_all_types =
+    iqk_type_bit(GGML_TYPE_Q2_K)    | iqk_type_bit(GGML_TYPE_Q3_K)   | iqk_type_bit(GGML_TYPE_Q4_K)  |
+    iqk_type_bit(GGML_TYPE_Q5_K)    | iqk_type_bit(GGML_TYPE_Q6_K)   | iqk_type_bit(GGML_TYPE_IQ4_XS) |
+    iqk_type_bit(GGML_TYPE_IQ2_XXS) | iqk_type_bit(GGML_TYPE_IQ2_XS) | iqk_type_bit(GGML_TYPE_IQ2_S) |
+    iqk_type_bit(GGML_TYPE_IQ3_XXS) | iqk_type_bit(GGML_TYPE_IQ3_S)  | iqk_type_bit(GGML_TYPE_IQ1_S) |
+    iqk_type_bit(GGML_TYPE_IQ1_M);
+
+#ifdef IQK_IMPLEMENT
+constexpr uint64_t k_iqk_built_types = k_iqk_all_types;
+#else
+constexpr uint64_t k_iqk_built_types = 0;
+#endif
+
+std::atomic<uint64_t> g_iqk_types{k_iqk_built_types};
+std::atomic<int64_t>  g_iqk_count[64];
+int                   g_iqk_debug = 0;
+bool                  g_iqk_first = false;
+bool                  g_iqk_auto  = false;
+
+#ifdef IQK_IMPLEMENT
+
+bool iqk_set_kernels(int type, mul_mat_t * funcs) {
+    for (int i = 0; i < IQK_MAX_NY; ++i) funcs[i] = nullptr;
+    return iqk_set_kernels_kquants(type, funcs) || iqk_set_kernels_iquants(type, funcs) || iqk_set_kernels_1bit(type, funcs);
+}
+
+// rows [0, nrc_x) of vx times the activation rows [info.cur_y, nrc_y)
+void iqk_mul_mat_NxM(const mul_mat_t * funcs, int n, const void * vx, size_t bx, DataInfo & info, int nrc_x, int nrc_y) {
+    constexpr int k_x_step = 64;
+    int ny = IQK_MAX_NY;
+    while (ny > 0 && !funcs[ny-1]) --ny;
+    int n_left = nrc_y - info.cur_y;
+    int n_step = n_left/ny;
+    if (n_step > 0) {
+        if (n_step*ny != n_left) {
+            ++n_step;
+            int ny1 = n_left/n_step;
+            int ny2 = ny1 + 1;
+            int my1 = n_step*ny2 - n_left;
+            int my2 = n_step - my1;
+            for (int ix = 0; ix < nrc_x; ix += k_x_step) {
+                auto this_info = info;
+                this_info.s += ix;
+                int this_nrc_x = ix + k_x_step <= nrc_x ? k_x_step : nrc_x - ix;
+                for (int iy = 0; iy < my1; ++iy) {
+                    funcs[ny1-1](n, (const void *)((const char *)vx + ix*bx), bx, this_info, this_nrc_x);
+                    this_info.cur_y += ny1;
+                }
+                for (int iy = 0; iy < my2; ++iy) {
+                    funcs[ny2-1](n, (const void *)((const char *)vx + ix*bx), bx, this_info, this_nrc_x);
+                    this_info.cur_y += ny2;
+                }
+            }
+            info.cur_y += n_left;
+        }
+        else {
+            for (int ix = 0; ix < nrc_x; ix += k_x_step) {
+                auto this_info = info;
+                this_info.s += ix;
+                int this_nrc_x = ix + k_x_step <= nrc_x ? k_x_step : nrc_x - ix;
+                for (int iy = 0; iy < n_step; ++iy) {
+                    funcs[ny-1](n, (const void *)((const char *)vx + ix*bx), bx, this_info, this_nrc_x);
+                    this_info.cur_y += ny;
+                }
+            }
+            info.cur_y += ny * n_step;
+        }
+    }
+    n_left = nrc_y - info.cur_y;
+    if (n_left > 0) {
+        funcs[n_left-1](n, vx, bx, info, nrc_x);
+    }
+}
+
+#endif // IQK_IMPLEMENT
+
+} // namespace
+
+extern "C" {
+
+void ggml_cpu_iqk_init(void) {
+    uint64_t mask = k_iqk_built_types;
+    const char * on = getenv("GGML_CPU_IQK");
+#if defined(__x86_64__) || defined(_M_X64)
+    // x86: by default the kernels take only the small batches where they measured faster (ggml_cpu_iqk_mode); the
+    // tiled K-quant path keeps the large ones, where it measured 1.2-5x faster.
+    g_iqk_auto = on == NULL;
+#endif
+    if (on != NULL && atoi(on) == 0) {
+        mask = 0;
+    }
+    g_iqk_first = on != NULL && atoi(on) == 2;
+    const char * env = getenv("GGML_CPU_IQK_TYPES");
+    if (mask != 0 && env != NULL && strcmp(env, "all") != 0) {
+        uint64_t sel = 0;
+        char buf[256];
+        snprintf(buf, sizeof(buf), "%s", env);
+        for (char * tok = strtok(buf, ", "); tok != NULL; tok = strtok(NULL, ", ")) {
+            for (int t = 0; t < GGML_TYPE_COUNT && t < 64; ++t) {
+                const char * name = ggml_type_name((enum ggml_type) t);
+                if (name != NULL && strcmp(name, tok) == 0) {
+                    sel |= 1ull << t;
+                }
+            }
+        }
+        mask &= sel;
+    }
+    g_iqk_types.store(mask);
+    const char * dbg = getenv("GGML_CPU_IQK_DEBUG");
+    g_iqk_debug = dbg != NULL ? atoi(dbg) : 0;
+    if (g_iqk_debug) {
+        fprintf(stderr, "ggml-cpu iqk gemm: built types 0x%llx, enabled 0x%llx (%s the tiled path):", (unsigned long long) k_iqk_built_types,
+                (unsigned long long) mask, g_iqk_auto ? "by batch size around" : g_iqk_first ? "ahead of" : "after");
+        for (int t = 0; t < GGML_TYPE_COUNT && t < 64; ++t) {
+            if ((mask >> t) & 1) fprintf(stderr, " %s", ggml_type_name((enum ggml_type) t));
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
+bool ggml_cpu_iqk_type_enabled(int type) {
+    return type >= 0 && type < 64 && ((g_iqk_types.load(std::memory_order_relaxed) >> type) & 1);
+}
+
+bool ggml_cpu_iqk_before_tiled(void) {
+    return g_iqk_first;
+}
+
+// x86 default (GGML_CPU_IQK unset), from test-backend-ops MUL_MAT perf (m = 4096, k = 14336) on Zen 3 (EPYC 7763),
+// Zen 4 (EPYC 9V74), Zen 5 (EPYC 9V45), Xeon 8370C / 8573C and Core i7-8700B, iqk vs the path that runs otherwise:
+//   ne11 = 1: vec_dot; iqk was slower for iq1_m / iq2_s / iq2_xxs (0.63-0.89x) and even for the others;
+//   ne11 = 2..7: iqk, 1.05-3.2x faster than vec_dot (lowest: q6_K at ne11 = 2 on Zen 4, 0.96x);
+//   ne11 = 8: iqk ahead of tiled, 1.02-2.9x, except iq2_xxs / iq3_s (0.84x / 0.91x on Zen 5);
+//   ne11 = 9..12: iqk for q2_K..q6_K (1.01-2.3x); the I-quants measured slower than tiled there;
+//   ne11 > 12: tiled (iqk 0.16-0.98x from ne11 = 16 up; ne11 = 512: 0.19-0.91x).
+int ggml_cpu_iqk_mode(int type, int64_t ne11) {
+    if (!ggml_cpu_iqk_type_enabled(type)) {
+        return 0;
+    }
+    if (!g_iqk_auto) {
+        return g_iqk_first ? 2 : 1;
+    }
+    if (ne11 < 2) {
+        return 0;
+    }
+    if (ne11 < 8) {
+        return 2;
+    }
+    if (ne11 == 8) {
+        return type == GGML_TYPE_IQ2_XXS || type == GGML_TYPE_IQ3_S ? 0 : 2;
+    }
+    const bool kquant = type == GGML_TYPE_Q2_K || type == GGML_TYPE_Q3_K || type == GGML_TYPE_Q4_K ||
+                        type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K;
+    return ne11 <= 12 && kquant ? 2 : 0;
+}
+
+int64_t ggml_cpu_iqk_count(int type) {
+    return type >= 0 && type < 64 ? g_iqk_count[type].load() : 0;
+}
+
+void ggml_cpu_iqk_set_types(uint64_t mask) {
+    g_iqk_types.store(mask & k_iqk_built_types);
+}
+
+bool ggml_cpu_iqk_mul_mat(int type, int64_t Nx, int64_t Ny, int64_t ne00,
+                          const void * A, size_t stride_A, const void * B, size_t stride_B,
+                          float * C, size_t stride_C, int ith, int nth) {
+#ifdef IQK_IMPLEMENT
+    if (ne00 % QK_K != 0 || Nx <= 0 || Ny <= 0 || Nx > INT32_MAX || Ny > INT32_MAX || ne00 > INT32_MAX) {
+        return false;
+    }
+    mul_mat_t funcs[IQK_MAX_NY];
+    if (!iqk_set_kernels(type, funcs)) {
+        return false;
+    }
+    if (ith == 0) {
+        const int64_t prev = g_iqk_count[type].fetch_add(1, std::memory_order_relaxed);
+        if (g_iqk_debug && prev == 0) {
+            fprintf(stderr, "ggml-cpu iqk gemm: first %s mul_mat (%lld x %lld x %lld, %d threads)\n",
+                    ggml_type_name((enum ggml_type) type), (long long) Nx, (long long) Ny, (long long) ne00, nth);
+        }
+    }
+
+    // Tiles of rows x activation columns: the rows are split over the threads first (each thread then walks all
+    // columns of its row range, 64 rows x up to 8 columns per kernel call); with fewer than 16 rows per thread the
+    // columns are split too.
+    const int nx = (int) Nx;
+    const int ny = (int) Ny;
+    int ntile_x = nth < nx/16 ? nth : (nx/16 > 0 ? nx/16 : 1);
+    int ntile_y = nth/ntile_x;
+    if (ntile_y > (ny + 7)/8) ntile_y = (ny + 7)/8;
+    if (ntile_y < 1) ntile_y = 1;
+    const int ntile = ntile_x*ntile_y;
+    for (int itile = ith; itile < ntile; itile += nth) {
+        const int jx = itile % ntile_x;
+        const int jy = itile / ntile_x;
+        const int ix0 = (int)((int64_t) jx      * nx / ntile_x);
+        const int ix1 = (int)((int64_t)(jx + 1) * nx / ntile_x);
+        const int iy0 = (int)((int64_t) jy      * ny / ntile_y);
+        const int iy1 = (int)((int64_t)(jy + 1) * ny / ntile_y);
+        if (ix1 <= ix0 || iy1 <= iy0) {
+            continue;
+        }
+        DataInfo info{C + ix0, (const char *) B, stride_C, stride_B, iy0};
+        iqk_mul_mat_NxM(funcs, (int) ne00, (const char *) A + ix0*stride_A, stride_A, info, ix1 - ix0, iy1);
+    }
+    return true;
+#else
+    (void) type; (void) Nx; (void) Ny; (void) ne00; (void) A; (void) stride_A; (void) B; (void) stride_B;
+    (void) C; (void) stride_C; (void) ith; (void) nth;
+    return false;
+#endif
+}
+
+} // extern "C"
diff --git a/src/ggml-cpu/iqk/iqk_gemm.h b/src/ggml-cpu/iqk/iqk_gemm.h
new file mode 100644
index 0000000..a36b5d7
--- /dev/null
+++ b/src/ggml-cpu/iqk/iqk_gemm.h
@@ -0,0 +1,45 @@
+#pragma once
+
+// GEMM kernels ported from ik_llama.cpp (iqk_gemm.cpp) for the k-quant / i-quant weight types whose
+// activations are Q8_K. They read the upstream block layouts and the upstream Q8_K activation rows and
+// form the same integer products as the ggml vec_dot kernels; only the float accumulation order differs.
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Reads once: GGML_CPU_IQK (0 disables; 1 enables, the default on ARM, while x86 defaults to small batches only; 2 also runs them
+// ahead of the x86 tiled K-quant path),
+// GGML_CPU_IQK_TYPES (ggml type names or "all"; the other types keep the tiled / vec_dot paths) and GGML_CPU_IQK_DEBUG
+// (1: print the enabled types and the first mul_mat per type to stderr).
+void ggml_cpu_iqk_init(void);
+
+// true if this build has a kernel for the weight type and it is enabled
+bool ggml_cpu_iqk_type_enabled(int type);
+
+// GGML_CPU_IQK=2: the iqk kernels take the op before the tiled path gets a chance
+bool ggml_cpu_iqk_before_tiled(void);
+
+// For a weight type and src1 row count: 0 = not iqk, 1 = iqk after the tiled path, 2 = iqk ahead of it.
+// GGML_CPU_IQK=1 / 2 give 1 / 2 for every enabled type; unset on x86 picks by batch size (see iqk_gemm.cpp).
+int ggml_cpu_iqk_mode(int type, int64_t ne11);
+
+// C[iy*stride_C + ix] = dot(A row ix, B row iy) for ix < Nx, iy < Ny; A rows of type `type` (stride_A bytes),
+// B rows are Q8_K (stride_B bytes), ne00 % 256 == 0. The work is split over the nth threads by ith.
+// Returns false (computing nothing) if the type is not handled.
+bool ggml_cpu_iqk_mul_mat(int type, int64_t Nx, int64_t Ny, int64_t ne00,
+                          const void * A, size_t stride_A, const void * B, size_t stride_B,
+                          float * C, size_t stride_C, int ith, int nth);
+
+// test hooks (reached through the CPU backend's get_proc_address): number of mul_mat ops computed by
+// these kernels per weight type, and an override of the enabled type mask (bit = ggml type)
+int64_t ggml_cpu_iqk_count(int type);
+void    ggml_cpu_iqk_set_types(uint64_t mask);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/ggml-cpu/iqk/iqk_gemm_1bit.cpp b/src/ggml-cpu/iqk/iqk_gemm_1bit.cpp
