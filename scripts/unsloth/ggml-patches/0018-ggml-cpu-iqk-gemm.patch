+bool iqk_set_kernels_1bit(int typeA, mul_mat_t * funcs) {
+    switch (typeA) {
+        case GGML_TYPE_IQ1_S: IQK_SET_MUL_MAT_FUNCTIONS(mul_mat_iq1_s_q8_K, funcs); break;
+        case GGML_TYPE_IQ1_M: IQK_SET_MUL_MAT_FUNCTIONS(mul_mat_iq1_m_q8_K, funcs); break;
+        default: return false;
+    }
+    return iq1s_grid_us_init();
+}
