+    const enum ggml_op ops[4] = { GGML_OP_GROUP_NORM, GGML_OP_MUL, GGML_OP_ADD, GGML_OP_UNARY };
+    if (!ggml_can_fuse_ext(cgraph, idx, ops, 3)) {
+        return 0;
+    }
+    ggml_tensor * mul = cgraph->nodes[i_mul];
+    ggml_tensor * add = cgraph->nodes[i_add];
+    const ggml_tensor * w = mul->src[0] == gn ? mul->src[1] : mul->src[0];
+    const ggml_tensor * b = add->src[0] == mul ? add->src[1] : add->src[0];
+    const int64_t C = gn->ne[2];
+    auto per_channel = [&](const ggml_tensor * t) {
+        return t != nullptr && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && t->ne[0] == 1 && t->ne[1] == 1 &&
+               t->ne[2] == C && t->ne[3] == 1;
+    };
+    if (!per_channel(w) || !per_channel(b) || mul->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 ||
