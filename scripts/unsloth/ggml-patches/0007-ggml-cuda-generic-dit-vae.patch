+        for (int j = from + 1; j < cgraph->n_nodes; ++j) {
+            const ggml_tensor * n = cgraph->nodes[j];
+            const bool view = n->op == GGML_OP_RESHAPE || n->op == GGML_OP_VIEW || n->op == GGML_OP_PERMUTE ||
+                              n->op == GGML_OP_TRANSPOSE;
+            if (view && n->src[0] != prev && n->view_src != prev) {
+                continue;
+            }
+            return j;
+        }
+        return -1;
+    };
