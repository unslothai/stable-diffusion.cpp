index 00000000..eb6298ea
--- /dev/null
+++ b/src/ggml-cuda/group-norm-par.cuh
@@ -0,0 +1,15 @@
+#pragma once
+#include "common.cuh"
+
+// Parallel GROUP_NORM with the stock kernel's exact arithmetic, optionally fused with the
+// per-channel affine (MUL by w, ADD of b, both [1, 1, C, 1]) and a SiLU that follow it in the graph.
+// Returns false (nothing launched) when the inputs are outside what it handles; the caller then
+// runs the stock ops. GGML_CUDA_GROUP_NORM_PAR=0 turns it off.
+bool ggml_cuda_group_norm_par_enabled();
+
+bool ggml_cuda_group_norm_par_supported(const ggml_tensor * gn);
+
+// gn: the GROUP_NORM node; w / b: affine operands or nullptr; silu: apply SiLU; out: the tensor
+// that receives the result (the last fused node).
+void ggml_cuda_op_group_norm_par(ggml_backend_cuda_context & ctx, const ggml_tensor * gn, const ggml_tensor * w,
+                                 const ggml_tensor * b, bool silu, ggml_tensor * out);
diff --git a/src/ggml-cuda/mul-add-fused.cu b/src/ggml-cuda/mul-add-fused.cu
new file mode 100644
index 00000000..29484ce4
--- /dev/null
+++ b/src/ggml-cuda/mul-add-fused.cu
@@ -0,0 +1,172 @@
+#include "mul-add-fused.cuh"
+#include "ggml-impl.h"
+
+static bool mul_add_fusion_enabled() {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_FUSE_MUL_ADD");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return enabled;
+}
+
+struct mad_operand {
+    const float * p;
+    int64_t ne[4];
+    int64_t nb[4]; // in elements
+};
+
+static __device__ __forceinline__ const float * mad_row(const mad_operand & o, const int64_t i1, const int64_t i2, const int64_t i3) {
+    return o.p + (o.ne[1] == 1 ? 0 : i1 * o.nb[1]) + (o.ne[2] == 1 ? 0 : i2 * o.nb[2]) + (o.ne[3] == 1 ? 0 : i3 * o.nb[3]);
+}
+
+static __device__ __forceinline__ float mad_at(const float * row, const mad_operand & o, const int64_t i0) {
+    return row[o.ne[0] == 1 ? 0 : i0 * o.nb[0]];
+}
+
+// one block per output row; y = (a*b) + c [+ d], b, c, d broadcast like binbcast (dims of size 1)
+template <bool has_d>
+static __global__ void mul_add_fused_f32(const mad_operand a, const mad_operand b, const mad_operand c, const mad_operand d,
+                                         float * __restrict__ dst, const int64_t ne0, const int64_t ne1, const int64_t ne2) {
+    const int64_t r  = blockIdx.x;
+    const int64_t i1 = r % ne1;
+    const int64_t i2 = (r / ne1) % ne2;
+    const int64_t i3 = r / (ne1 * ne2);
+    const float * ra = mad_row(a, i1, i2, i3);
+    const float * rb = mad_row(b, i1, i2, i3);
+    const float * rc = mad_row(c, i1, i2, i3);
+    const float * rd = has_d ? mad_row(d, i1, i2, i3) : nullptr;
+    float * out = dst + r * ne0;
+    for (int64_t i0 = threadIdx.x; i0 < ne0; i0 += blockDim.x) {
+        float y = __fmul_rn(mad_at(ra, a, i0), mad_at(rb, b, i0));
+        y = __fadd_rn(y, mad_at(rc, c, i0));
+        if constexpr (has_d) {
+            y = __fadd_rn(y, mad_at(rd, d, i0));
+        }
+        out[i0] = y;
+    }
+}
+
+static bool mad_ok_operand(const ggml_tensor * t, const ggml_tensor * out) {
+    if (t == nullptr || t->type != GGML_TYPE_F32 || t->nb[0] != sizeof(float)) {
+        return false;
+    }
+    for (int k = 0; k < 4; ++k) {
+        if (t->ne[k] != out->ne[k] && t->ne[k] != 1) {
+            return false;
+        }
+        if (t->nb[k] % sizeof(float) != 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static mad_operand mad_make(const ggml_tensor * t) {
+    mad_operand o;
+    o.p = (const float *) t->data;
+    for (int k = 0; k < 4; ++k) {
+        o.ne[k] = t->ne[k];
+        o.nb[k] = t->nb[k] / (int64_t) sizeof(float);
+    }
+    return o;
+}
+
+static bool mad_is_skippable_view(const ggml_tensor * n, const ggml_tensor * prev) {
+    const bool view = n->op == GGML_OP_RESHAPE || n->op == GGML_OP_VIEW || n->op == GGML_OP_PERMUTE || n->op == GGML_OP_TRANSPOSE;
+    return view && n->src[0] != prev && n->view_src != prev;
+}
+
+int ggml_cuda_try_fuse_mul_add(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    if (!mul_add_fusion_enabled()) {
+        return 0;
+    }
+    ggml_tensor * mul = cgraph->nodes[i];
+    if (mul->op != GGML_OP_MUL || mul->type != GGML_TYPE_F32 || !ggml_is_contiguous(mul) || !ggml_node_has_n_uses(cgraph, i, 1)) {
+        return 0;
+    }
+    auto next_op = [&](int from) {
+        for (int j = from + 1; j < cgraph->n_nodes; ++j) {
+            if (!mad_is_skippable_view(cgraph->nodes[j], cgraph->nodes[from])) {
+                return j;
+            }
+        }
+        return -1;
+    };
+    // the full-shape factor goes first so the output shape is the MUL's shape
+    const ggml_tensor * a = mul->src[0];
+    const ggml_tensor * b = mul->src[1];
+    if (!ggml_are_same_shape(a, mul)) {
+        std::swap(a, b);
+    }
+    if (!ggml_are_same_shape(a, mul) || !mad_ok_operand(a, mul) || !mad_ok_operand(b, mul)) {
+        return 0;
+    }
+    const int i_add = next_op(i);
+    if (i_add < 0) {
+        return 0;
+    }
+    ggml_tensor * add = cgraph->nodes[i_add];
+    // under ggml_build_forward_select only GGML_TENSOR_FLAG_COMPUTE nodes run: never fuse an inactive node
+    if (add->op != GGML_OP_ADD || (add->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || add->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(add) || !ggml_are_same_shape(add, mul) || (add->src[0] != mul && add->src[1] != mul)) {
+        return 0;
+    }
+    const ggml_tensor * c = add->src[0] == mul ? add->src[1] : add->src[0];
+    if (c == mul || !mad_ok_operand(c, add)) {
+        return 0;
+    }
+    int last = i_add;
+    const ggml_tensor * d = nullptr;
+    if (ggml_node_has_n_uses(cgraph, i_add, 1)) {
+        const int i_add2 = next_op(i_add);
+        if (i_add2 > 0) {
+            ggml_tensor * add2 = cgraph->nodes[i_add2];
+            if (add2->op == GGML_OP_ADD && (add2->flags & GGML_TENSOR_FLAG_COMPUTE) && add2->type == GGML_TYPE_F32 && ggml_is_contiguous(add2) && ggml_are_same_shape(add2, add) &&
+                (add2->src[0] == add || add2->src[1] == add)) {
+                const ggml_tensor * dd = add2->src[0] == add ? add2->src[1] : add2->src[0];
+                if (dd != add && dd != mul && mad_ok_operand(dd, add2)) {
+                    d    = dd;
+                    last = i_add2;
+                }
+            }
+        }
+    }
+    for (int j = i + 1; j < last; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (j != i_add && !(n->op == GGML_OP_RESHAPE || n->op == GGML_OP_VIEW || n->op == GGML_OP_PERMUTE || n->op == GGML_OP_TRANSPOSE)) {
+            return 0;
+        }
+    }
+    ggml_tensor * out = cgraph->nodes[last];
+    // the output may only alias the elementwise inputs at the same element (in-place adds)
+    auto overlaps = [&](const ggml_tensor * t) {
+        if (t == nullptr || t->data == nullptr) {
+            return false;
+        }
+        const char * o0 = (const char *) out->data;
+        const char * o1 = o0 + ggml_nbytes(out);
+        const char * t0 = (const char *) t->data;
+        const char * t1 = t0 + ggml_nbytes(t);
+        return t0 < o1 && o0 < t1;
+    };
+    auto same_layout = [&](const ggml_tensor * t) {
+        return t->data == out->data && ggml_are_same_shape(t, out) && ggml_is_contiguous(t);
+    };
+    for (const ggml_tensor * t : { a, b, c, d }) {
+        if (overlaps(t) && !same_layout(t)) {
+            return 0;
+        }
+    }
+    const int64_t nrows = ggml_nrows(out);
+    if (nrows > INT_MAX) {
+        return 0;
+    }
+    const int threads = (int) std::min<int64_t>(256, std::max<int64_t>(32, (out->ne[0] + 31) / 32 * 32));
+    const mad_operand oa = mad_make(a), ob = mad_make(b), oc = mad_make(c), od = d ? mad_make(d) : oc;
+    if (d) {
+        mul_add_fused_f32<true><<<(unsigned int) nrows, threads, 0, ctx.stream()>>>(oa, ob, oc, od, (float *) out->data, out->ne[0], out->ne[1], out->ne[2]);
+    } else {
+        mul_add_fused_f32<false><<<(unsigned int) nrows, threads, 0, ctx.stream()>>>(oa, ob, oc, od, (float *) out->data, out->ne[0], out->ne[1], out->ne[2]);
+    }
+    return last - i;
+}
diff --git a/src/ggml-cuda/mul-add-fused.cuh b/src/ggml-cuda/mul-add-fused.cuh
