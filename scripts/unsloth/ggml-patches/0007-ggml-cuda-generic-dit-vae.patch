+#include "common.cuh"
+
+// MUL -> ADD [-> ADD] chains of F32 elementwise ops with broadcast operands (adaLN modulate
+// x + x*scale (+ shift), gated residual r + y*gate): one pass instead of two or three, each
+// product and sum still rounded separately (bit-identical to the unfused MUL / ADD kernels).
+// Returns the number of extra nodes consumed. GGML_CUDA_FUSE_MUL_ADD=0 turns it off.
+int ggml_cuda_try_fuse_mul_add(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i);
diff --git a/src/ggml-cuda/norm-channel.cu b/src/ggml-cuda/norm-channel.cu
new file mode 100644
index 00000000..9c0b61fd
--- /dev/null
+++ b/src/ggml-cuda/norm-channel.cu
@@ -0,0 +1,254 @@
+#include "norm-channel.cuh"
+#include "ggml-impl.h"
+
+// The unfused RMS_NORM over rows of C < 1024 channels runs rms_norm_f32<256> (1024 threads from 1024
+// channels; that tree is reproduced too) (or the narrow-block
+// variant, documented bit-identical to it): thread t sums squares of columns t, t+256, ... (in that
+// order), each warp reduces its 32 partials with the xor butterfly, and the 8 warp sums plus 24 zero
+// partials are reduced by the same butterfly. Here one thread owns one spatial position (so loads
+// across a warp are contiguous) and evaluates exactly that reduction tree in registers.
+
+static bool norm_channel_enabled() {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    return false;
+#else
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_NORM_CHANNEL");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return enabled && WARP_SIZE == 32;
+#endif
+}
+
+// GGML_CUDA_NORM_CHANNEL=2 fuses at every size (tests); by default only where it beats the unfused chain.
+static bool norm_channel_forced() {
+    static const bool forced = [] {
+        const char * e = getenv("GGML_CUDA_NORM_CHANNEL");
+        return e != nullptr && atoi(e) == 2;
+    }();
+    return forced;
+}
+
+static __device__ __forceinline__ float nc_butterfly32(float * v) {
+    // value every lane holds after warp_reduce_sum: lane l adds lane l^off at each step
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+#pragma unroll
+        for (int l = 0; l < off; ++l) {
+            v[l] = v[l] + v[l + off];
+        }
+    }
+    return v[0];
+}
+
+// BLOCK: the thread count of the rms_norm_f32 launch this reproduces (256 below 1024 columns, else 1024)
+template <int BLOCK>
+static __global__ void rms_norm_channel_f32(const float * x, const float * __restrict__ w, float * dst,
+                                            const int C, const int64_t P, const int64_t inner, const float eps) {
+    const int64_t q = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (q >= P) {
+        return;
+    }
+    // position q = (outer index, inner index); its channel c sits at base + c*inner
+    const int64_t p = (q / inner) * inner * C + q % inner;
+    const float * xp = x + p;
+    float wsum[32];
+#pragma unroll
+    for (int i = 0; i < 32; ++i) {
+        wsum[i] = 0.0f;
+    }
+#pragma unroll 1
+    for (int wi = 0; wi < BLOCK / 32; ++wi) {
+        float lane[32];
+#pragma unroll
+        for (int l = 0; l < 32; ++l) {
+            float tmp = 0.0f;
+            for (int col = wi * 32 + l; col < C; col += BLOCK) {
+                const float xi = xp[(int64_t) col * inner];
+                tmp += xi * xi;
+            }
+            lane[l] = tmp;
+        }
+        wsum[wi] = nc_butterfly32(lane);
+    }
+    const float tmp   = nc_butterfly32(wsum);
+    const float mean  = tmp / C;
+    const float scale = rsqrtf(mean + eps);
+    for (int col = 0; col < C; ++col) {
+        dst[p + (int64_t) col * inner] = scale * xp[(int64_t) col * inner] * w[col];
+    }
+}
+
+static bool nc_debug() {
+    static const bool on = getenv("GGML_CUDA_NORM_CHANNEL_DEBUG") != nullptr;
+    return on;
+}
+#define NC_REJECT(why) do { if (nc_debug()) { GGML_LOG_INFO("norm-channel: node %d (%s) rejected: %s\n", i, cont1->name, why); } return 0; } while (0)
+
+static bool is_view_op(const ggml_tensor * t) {
+    return t->op == GGML_OP_PERMUTE || t->op == GGML_OP_VIEW || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_TRANSPOSE;
+}
+
+int ggml_cuda_try_fuse_rms_norm_channel(ggml_backend_cuda_context & ctx, ggml_cgraph * cgraph, int i) {
+    if (!norm_channel_enabled()) {
+        return 0;
+    }
+    // node i: CONT whose source is a permuted view of a contiguous F32 x: cont[c, a, b, d] = x[a, b, d, c]
+    ggml_tensor * cont1 = cgraph->nodes[i];
+    if (cont1->op != GGML_OP_CONT || cont1->type != GGML_TYPE_F32) {
+        return 0;
+    }
+    const ggml_tensor * pv = cont1->src[0];
+    if (pv == nullptr || pv->op != GGML_OP_PERMUTE || pv->type != GGML_TYPE_F32) {
+        return 0;
+    }
+    const ggml_tensor * x = pv->src[0];
+    if (x == nullptr || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || pv->view_offs != 0 || pv->data != x->data) {
+        NC_REJECT("check 1");
+    }
+    // pv dim 0 (the normalised axis) must be one axis k of x; the other axes may come in any order
+    const int64_t C = pv->ne[0];
+    int k = -1;
+    for (int m = 0; m < GGML_MAX_DIMS; ++m) {
+        if (x->ne[m] == C && x->nb[m] == pv->nb[0] && (k < 0 || x->ne[m] > 1)) {
+            k = m;
+        }
+    }
+    // map every pv axis j > 0 of size > 1 to the x axis it reads
+    int pv_from_x[GGML_MAX_DIMS] = { -1, -1, -1, -1 };
+    pv_from_x[0] = k;
+    bool layout_ok = k >= 0 && C >= 1 && ggml_nelements(pv) == ggml_nelements(x);
+    for (int j = 1; j < GGML_MAX_DIMS && layout_ok; ++j) {
+        if (pv->ne[j] == 1) {
+            continue;
+        }
+        for (int m = 0; m < GGML_MAX_DIMS; ++m) {
+            if (m != k && x->ne[m] == pv->ne[j] && x->nb[m] == pv->nb[j]) {
+                pv_from_x[j] = m;
+            }
+        }
+        layout_ok = pv_from_x[j] >= 0;
+    }
+    if (!layout_ok) {
+        NC_REJECT("check 2");
+    }
+    const int64_t inner = x->nb[k] / (int64_t) sizeof(float);   // elements below the channel axis
+    const int64_t P     = ggml_nelements(x) / C;                 // positions normalised independently
+    // then RMS_NORM(cont1) and MUL(rms, w[C]) in that order (views in between are skipped)
+    auto next_op = [&](int from) {
+        for (int j = from + 1; j < cgraph->n_nodes; ++j) {
+            if (!is_view_op(cgraph->nodes[j]) || cgraph->nodes[j]->src[0] == cgraph->nodes[from]) {
+                return j;
+            }
+        }
+        return -1;
+    };
+    const int i_rms = next_op(i);
+    if (i_rms < 0) {
+        NC_REJECT("check 3");
+    }
+    ggml_tensor * rms = cgraph->nodes[i_rms];
+    const int i_mul = next_op(i_rms);
+    if (i_mul < 0) {
+        NC_REJECT("check 4");
+    }
+    ggml_tensor * mul = cgraph->nodes[i_mul];
+    if (rms->op != GGML_OP_RMS_NORM) {
+        if (nc_debug()) { GGML_LOG_INFO("norm-channel: C=%lld next op %s (%s)\n", (long long) C, ggml_op_desc(rms), rms->name); }
+        NC_REJECT("check 5a");
+    }
+    if (rms->src[0] != cont1) {
+        NC_REJECT("check 5b");
+    }
+    if (mul->op != GGML_OP_MUL || mul->src[0] != rms) {
+        if (nc_debug()) { GGML_LOG_INFO("norm-channel: C=%lld after rms %s (%s)\n", (long long) C, ggml_op_desc(mul), mul->name); }
+        NC_REJECT("check 5c");
+    }
+    if (!ggml_node_has_n_uses(cgraph, i, 1) || !ggml_node_has_n_uses(cgraph, i_rms, 1) || !ggml_node_has_n_uses(cgraph, i_mul, 1)) {
+        NC_REJECT("check 5d");
+    }
+    const ggml_tensor * w = mul->src[1];
+    if (w == nullptr || w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) || w->ne[0] != C || ggml_nelements(w) != C ||
+        mul->type != GGML_TYPE_F32 || !ggml_are_same_shape(mul, rms)) {
+        NC_REJECT("check 6");
+    }
+    // then PERMUTE(mul) back to x's layout and its CONT
+    const int i_pv2 = i_mul + 1;
+    if (i_pv2 + 1 >= cgraph->n_nodes) {
+        NC_REJECT("check 7");
+    }
+    ggml_tensor * pv2   = cgraph->nodes[i_pv2];
+    ggml_tensor * cont2 = cgraph->nodes[i_pv2 + 1];
+    bool back_ok = pv2->op == GGML_OP_PERMUTE && pv2->src[0] == mul && cont2->op == GGML_OP_CONT && cont2->src[0] == pv2 &&
+                   cont2->type == GGML_TYPE_F32 && ggml_are_same_shape(cont2, x) &&
+                   ggml_is_contiguous(cont2) && ggml_is_contiguous(mul);
+    // the graph does not count uses of views, so check by hand that cont2 is the only reader of pv2
+    for (int j = 0; j < cgraph->n_nodes && back_ok; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC && back_ok; ++s) {
+            back_ok = n == cont2 || n->src[s] != pv2;
+        }
+    }
+    // pv2 must be the inverse permutation: x axis m reads the mul axis that was built from x axis m
+    for (int j = 0; j < GGML_MAX_DIMS && back_ok; ++j) {
+        if (pv->ne[j] == 1 && j != 0) {
+            continue;
+        }
+        const int m = pv_from_x[j];
+        back_ok = x->ne[m] == 1 || pv2->nb[m] == mul->nb[j];
+    }
+    if (!back_ok) {
+        NC_REJECT("check 8");
+    }
+    // under ggml_build_forward_select only GGML_TENSOR_FLAG_COMPUTE nodes run: never fuse an inactive node
+    for (const ggml_tensor * n : { (const ggml_tensor *) cont1, (const ggml_tensor *) rms, (const ggml_tensor *) mul, (const ggml_tensor *) cont2 }) {
+        if ((n->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            NC_REJECT("check 8b");
+        }
+    }
+    // every node from i to the second CONT is part of the pattern or a view the loop skips
+    for (int j = i + 1; j < i_pv2 + 1; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (j != i_rms && j != i_mul && j != i_pv2 && !is_view_op(n)) {
+            NC_REJECT("check 9");
+        }
+    }
+    // The result may reuse x's memory (x is often dead after this norm): with the same layout every
+    // thread reads all channels of its position before writing them, so only partial overlap is unsafe.
+    const char * x0 = (const char *) x->data;
+    const char * d0 = (const char *) cont2->data;
+    const bool partial_overlap = d0 != x0 && d0 < x0 + ggml_nbytes(x) && x0 < d0 + ggml_nbytes(cont2);
+    // Unfused, w is read by the MUL before the second CONT writes, so the allocator may hand w's buffer to
+    // cont2; the fused kernel reads w while writing cont2, so any overlap with w is unsafe.
+    const char * w0       = (const char *) w->data;
+    const bool w_overlap  = d0 < w0 + ggml_nbytes(w) && w0 < d0 + ggml_nbytes(cont2);
+    if (P > INT64_C(1) << 40 || partial_overlap || w_overlap) {
+        NC_REJECT("check 10");
+    }
+    // One thread per position walks every channel, so the kernel needs many positions to fill the GPU.
+    // Measured on B200 against CONT + RMS_NORM + MUL + CONT (Qwen-Image VAE shapes, whole image and tiles):
+    // with C < 1024 it wins from 16384 positions (173 vs 245 us), with C >= 1024 from 65536 (1.2 vs 3.3 ms),
+    // and loses below (P = 4096, C = 1152: 656 vs 209 us).
+    if (!norm_channel_forced() && P < (C < 1024 ? 16384 : 65536)) {
+        NC_REJECT("check 12");
+    }
+    float eps;
+    memcpy(&eps, rms->op_params, sizeof(float));
+
+    const int threads = 128;
+    const int64_t blocks = (P + threads - 1) / threads;
+    if (blocks > INT_MAX) {
+        NC_REJECT("check 11");
+    }
+    if (C < 1024) {
+        rms_norm_channel_f32<256><<<(unsigned int) blocks, threads, 0, ctx.stream()>>>(
+            (const float *) x->data, (const float *) w->data, (float *) cont2->data, (int) C, P, inner, eps);
+    } else {
+        rms_norm_channel_f32<1024><<<(unsigned int) blocks, threads, 0, ctx.stream()>>>(
+            (const float *) x->data, (const float *) w->data, (float *) cont2->data, (int) C, P, inner, eps);
+    }
+    if (nc_debug()) {
+        GGML_LOG_INFO("norm-channel: fused C=%lld P=%lld\n", (long long) C, (long long) P);
+    }
+    return i_pv2 + 1 - i;
+}
