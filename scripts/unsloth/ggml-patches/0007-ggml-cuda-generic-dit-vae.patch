diff --git a/src/ggml-cuda/group-norm-par.cu b/src/ggml-cuda/group-norm-par.cu
new file mode 100644
index 00000000..3e640e62
--- /dev/null
+++ b/src/ggml-cuda/group-norm-par.cu
@@ -0,0 +1,173 @@
+#include "group-norm-par.cuh"
+#include "unary.cuh"
+
+// The stock group_norm_f32<1024> runs one 1024-thread block per group, so a VAE decode with 32
+// groups keeps 32 SMs busy and walks the group three times (sum, centred sum of squares, scale),
+// then the affine and the SiLU are three more full passes. Here the same reductions run spread over
+// the GPU without changing a single rounding:
+//   - thread t (0..1023) of the stock block sums x[g*G + t + 1024*k] in increasing k; each such
+//     chain is computed whole by one thread here too, 32 consecutive t per warp, so the warp sums
+//     (xor butterfly) are the same values the stock kernel writes to shared memory;
+//   - the 32 warp sums are combined by the same warp butterfly (stock: warp lanes read shared[lane]);
+//   - mean = sum / G and the centred pass use the same expressions, then scale = rsqrtf(var + eps);
+//   - y = (x - mean) * scale, then * w, + b, then silu, each rounded separately as in the
+//     unfused MUL / ADD / UNARY kernels.
+// Kernels: partial sums, partial centred squares, per-group stats, one elementwise apply pass.
+
+static constexpr int GN_PAR_THREADS = 1024; // the stock block size whose arithmetic is reproduced
+static constexpr int GN_PAR_WARPS   = GN_PAR_THREADS / WARP_SIZE;
+static constexpr int GN_PAR_WPB     = 4;    // warps per block in the reduction kernels
+
+bool ggml_cuda_group_norm_par_enabled() {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    return false;  // warp size / reduction differ from what is reproduced here
+#else
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_GROUP_NORM_PAR");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return enabled && WARP_SIZE == 32;
+#endif
+}
+
+static int64_t gn_par_group_size(const ggml_tensor * gn) {
+    const ggml_tensor * src0       = gn->src[0];
+    const int           num_groups = gn->op_params[0];
+    return src0->ne[0] * src0->ne[1] * ((src0->ne[2] + num_groups - 1) / num_groups);
+}
+
+bool ggml_cuda_group_norm_par_supported(const ggml_tensor * gn) {
+    if (!ggml_cuda_group_norm_par_enabled() || gn->op != GGML_OP_GROUP_NORM) {
+        return false;
+    }
+    const ggml_tensor * src0 = gn->src[0];
+    if (src0->type != GGML_TYPE_F32 || gn->type != GGML_TYPE_F32 || !ggml_is_contiguous(src0) || !ggml_is_contiguous(gn)) {
+        return false;
+    }
+    const int64_t group_size = gn_par_group_size(gn);
+    // the stock kernel uses its 1024-thread variant only from 1024 elements per group; it indexes with int
+    return group_size >= GN_PAR_THREADS && ggml_nelements(src0) < INT_MAX;
+}
+
+// one warp per (group, chain block of 32 threads): sum of x over the warp's 32 chains
+static __global__ void gn_par_sum(const float * __restrict__ x, float * __restrict__ part, const int group_size,
+                                  const int ne_elements) {
+    const int g    = blockIdx.x;
+    const int w    = blockIdx.y * GN_PAR_WPB + threadIdx.x / WARP_SIZE;
+    const int t    = w * WARP_SIZE + threadIdx.x % WARP_SIZE;
+    const int start = g * group_size + t;
+    const int end   = min(g * group_size + group_size, ne_elements);
+    float tmp = 0.0f;
+    for (int j = start; j < end; j += GN_PAR_THREADS) {
+        tmp += x[j];
+    }
+    tmp = warp_reduce_sum(tmp);
+    if (threadIdx.x % WARP_SIZE == 0) {
+        part[g * GN_PAR_WARPS + w] = tmp;
+    }
+}
+
+static __device__ __forceinline__ float gn_par_combine(const float * part, const int g) {
+    // stock: lanes read shared_vals[lane] (one value per warp) and reduce
+    return warp_reduce_sum(part[g * GN_PAR_WARPS + threadIdx.x % WARP_SIZE]);
+}
+
+static __global__ void gn_par_sqdev(const float * __restrict__ x, const float * __restrict__ part, float * __restrict__ part2,
+                                    const int group_size, const int ne_elements) {
+    const int g    = blockIdx.x;
+    const int w    = blockIdx.y * GN_PAR_WPB + threadIdx.x / WARP_SIZE;
+    const int t    = w * WARP_SIZE + threadIdx.x % WARP_SIZE;
+    const int start = g * group_size + t;
+    const int end   = min(g * group_size + group_size, ne_elements);
+
+    float tmp = gn_par_combine(part, g);
+    const float mean = tmp / group_size;
+    tmp = 0.0f;
+    for (int j = start; j < end; j += GN_PAR_THREADS) {
+        const float xi = x[j] - mean;
+        tmp += xi * xi;
+    }
+    tmp = warp_reduce_sum(tmp);
+    if (threadIdx.x % WARP_SIZE == 0) {
+        part2[g * GN_PAR_WARPS + w] = tmp;
+    }
+}
+
+static __global__ void gn_par_stats(const float * __restrict__ part, const float * __restrict__ part2, float2 * __restrict__ stats,
+                                    const int group_size, const float eps) {
+    const int g = blockIdx.x;
+    float tmp = gn_par_combine(part, g);
+    const float mean = tmp / group_size;
+    tmp = gn_par_combine(part2, g);
+    const float variance = tmp / group_size;
+    const float scale    = rsqrtf(variance + eps);
+    if (threadIdx.x == 0) {
+        stats[g] = make_float2(mean, scale);
+    }
+}
+
+template <bool affine, bool silu>
+static __global__ void gn_par_apply(const float * x, const float2 * __restrict__ stats, const float * __restrict__ w,
+                                    const float * __restrict__ b, float * dst, const int64_t ne_elements,
+                                    const int group_size, const int64_t plane, const int64_t channels) {
+    const int64_t stride = (int64_t) gridDim.x * blockDim.x;
+    for (int64_t j = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; j < ne_elements; j += stride) {
+        const float2 st = stats[j / group_size];
+        float y = __fmul_rn(__fsub_rn(x[j], st.x), st.y);
+        if constexpr (affine) {
+            const int64_t c = (j / plane) % channels;
+            y = __fmul_rn(y, w[c]);
+            y = __fadd_rn(y, b[c]);
+        }
+        if constexpr (silu) {
+            y = ggml_cuda_op_silu_single(y);
+        }
+        dst[j] = y;
+    }
+}
+
+void ggml_cuda_op_group_norm_par(ggml_backend_cuda_context & ctx, const ggml_tensor * gn, const ggml_tensor * w,
+                                 const ggml_tensor * b, bool silu, ggml_tensor * out) {
+    const ggml_tensor * src0 = gn->src[0];
+    const float * x = (const float *) src0->data;
+    float * dst = (float *) out->data;
+    cudaStream_t stream = ctx.stream();
+
+    const int num_groups = gn->op_params[0];
+    float eps;
+    memcpy(&eps, gn->op_params + 1, sizeof(float));
+
+    const int group_size  = (int) gn_par_group_size(gn);
+    const int ne_elements = (int) ggml_nelements(src0);
+    const int n_groups    = num_groups * (int) src0->ne[3];
+
+    ggml_cuda_pool_alloc<float>  part(ctx.pool(), (size_t) n_groups * GN_PAR_WARPS);
+    ggml_cuda_pool_alloc<float>  part2(ctx.pool(), (size_t) n_groups * GN_PAR_WARPS);
+    ggml_cuda_pool_alloc<float2> stats(ctx.pool(), (size_t) n_groups);
+
+    const dim3 rgrid(n_groups, GN_PAR_WARPS / GN_PAR_WPB, 1);
+    const dim3 rblock(GN_PAR_WPB * WARP_SIZE, 1, 1);
+    gn_par_sum<<<rgrid, rblock, 0, stream>>>(x, part.get(), group_size, ne_elements);
+    gn_par_sqdev<<<rgrid, rblock, 0, stream>>>(x, part.get(), part2.get(), group_size, ne_elements);
+    gn_par_stats<<<n_groups, WARP_SIZE, 0, stream>>>(part.get(), part2.get(), stats.get(), group_size, eps);
+
+    const int     threads = 256;
+    const int64_t want    = ((int64_t) ne_elements + threads - 1) / threads;
+    const int     blocks  = (int) std::min<int64_t>(want, (int64_t) ggml_cuda_info().devices[ctx.device].nsm * 32);
+    const int64_t plane   = src0->ne[0] * src0->ne[1];
+    const float * wd = w ? (const float *) w->data : nullptr;
+    const float * bd = b ? (const float *) b->data : nullptr;
+    if (w) {
+        if (silu) {
+            gn_par_apply<true, true><<<blocks, threads, 0, stream>>>(x, stats.get(), wd, bd, dst, ne_elements, group_size, plane, src0->ne[2]);
+        } else {
+            gn_par_apply<true, false><<<blocks, threads, 0, stream>>>(x, stats.get(), wd, bd, dst, ne_elements, group_size, plane, src0->ne[2]);
+        }
+    } else {
+        if (silu) {
+            gn_par_apply<false, true><<<blocks, threads, 0, stream>>>(x, stats.get(), wd, bd, dst, ne_elements, group_size, plane, src0->ne[2]);
+        } else {
+            gn_par_apply<false, false><<<blocks, threads, 0, stream>>>(x, stats.get(), wd, bd, dst, ne_elements, group_size, plane, src0->ne[2]);
+        }
+    }
+}
diff --git a/src/ggml-cuda/group-norm-par.cuh b/src/ggml-cuda/group-norm-par.cuh
