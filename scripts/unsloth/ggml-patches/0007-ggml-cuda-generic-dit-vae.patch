+    }
+    int n_fused = 3;
+    const int i_u = next_op(i_add, add);
+    if (i_u > 0) {
+        const ggml_tensor * u = cgraph->nodes[i_u];
+        idx[3] = i_u;
+        if (u->op == GGML_OP_UNARY && ggml_get_unary_op(u) == GGML_UNARY_OP_SILU && u->type == GGML_TYPE_F32 &&
