diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
index 30b8cbb..d4e93aa 100644
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -49,6 +49,66 @@
 
 #ifdef GGML_USE_LLAMAFILE
 #include "llamafile/sgemm.h"
+#if defined(__AVX2__) && !defined(__AVX512F__) && (!defined(_MSC_VER) || defined(__clang__)) && \
+    (defined(__x86_64__) || defined(__i386__) || defined(_M_X64))
+#include <cpuid.h>
+#endif
+
+// Weight types whose mul_mat may go through llamafile's tinyBLAS GEMM. Q8_0: its tinyBLAS kernel adds the per-block
+// products in the same 8 lanes and the same final reduction as ggml_vec_dot_q8_0_q8_0, so it returns the same bits,
+// only faster. F16 / BF16: both paths read the same F16 / BF16 activations and accumulate in F32, only in another
+// order (the text encoder, VAE and DiT F16 / BF16 matmuls). F32 doubles the rms error vs an F64 GEMM and stays
+// opt-in. GGML_CPU_SGEMM_TYPES=q8_0,bf16,f16,f32 (ggml type names), "all" or "none" overrides the default below;
+// GGML_CPU_SGEMM_TYPES=q8_0 restores the bit-identical-only set.
+//
+// Default: Q8_0 everywhere (1.07-1.11x on every x86 CPU measured). F16 / BF16 only where tinyBLAS measured faster
+// than vec_dot on SD1.5 F16 sampling: AVX512 builds (Zen 5 GCC 1.11-1.16x, Xeon 8573C GCC 1.74x / MSVC 1.88x) and
+// GCC / clang AVX2 builds on Intel (Xeon 8573C 1.30x, Core i7-8700B 1.6x). On AMD the AVX2 kernels ran slower than
+// vec_dot from the release toolchains (GCC 11: Zen 3 0.78x, Zen 4 0.88x; MSVC: Zen 3 0.71x, Zen 5 0.86x), so
+// F16 / BF16 stay opt-in there and in MSVC AVX2 builds.
+static uint64_t ggml_cpu_sgemm_types = 1ull << GGML_TYPE_Q8_0;
+
+static uint64_t ggml_cpu_sgemm_types_default(void) {
+    uint64_t mask = 1ull << GGML_TYPE_Q8_0;
+#if defined(__AVX512F__)
+    mask |= (1ull << GGML_TYPE_F16) | (1ull << GGML_TYPE_BF16);
+#elif defined(__AVX2__) && (!defined(_MSC_VER) || defined(__clang__)) && \
+    (defined(__x86_64__) || defined(__i386__) || defined(_M_X64))
+    unsigned int a = 0, b = 0, c = 0, d = 0;
+    if (__get_cpuid(0, &a, &b, &c, &d) && b == 0x756e6547 && d == 0x49656e69 && c == 0x6c65746e) {  // GenuineIntel
+        mask |= (1ull << GGML_TYPE_F16) | (1ull << GGML_TYPE_BF16);
+    }
+#endif
+    return mask;
+}
+
+static void ggml_cpu_sgemm_types_init(void) {
+    ggml_cpu_sgemm_types = ggml_cpu_sgemm_types_default();
+    const char * env = getenv("GGML_CPU_SGEMM_TYPES");
+    if (env == NULL) {
+        return;
+    }
+    if (strcmp(env, "all") == 0) {
+        ggml_cpu_sgemm_types = ~0ull;
+        return;
+    }
+    uint64_t mask = 0;
+    char buf[256];
+    snprintf(buf, sizeof(buf), "%s", env);
+    for (char * tok = strtok(buf, ", "); tok != NULL; tok = strtok(NULL, ", ")) {
+        for (int t = 0; t < GGML_TYPE_COUNT && t < 64; ++t) {
+            const char * name = ggml_type_name((enum ggml_type) t);
+            if (name != NULL && strcmp(name, tok) == 0) {
+                mask |= 1ull << t;
+            }
+        }
+    }
+    ggml_cpu_sgemm_types = mask;
+}
+
+static inline bool ggml_cpu_sgemm_type_enabled(enum ggml_type t) {
+    return t < 64 && ((ggml_cpu_sgemm_types >> t) & 1);
+}
 #endif
 
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
@@ -1460,7 +1520,7 @@ void ggml_compute_forward_mul_mat(
 
     const bool src1_cont = ggml_is_contiguous(src1);
 
-    if (!params->use_ref && src1_cont) {
+    if (!params->use_ref && src1_cont && ggml_cpu_sgemm_type_enabled(src0->type)) {
         for (int64_t i13 = 0; i13 < ne13; i13++)
             for (int64_t i12 = 0; i12 < ne12; i12++)
                 if (!llamafile_sgemm(params,
@@ -1539,7 +1599,7 @@ UseGgmlGemm1:;
     ggml_barrier(params->threadpool);
 
 #if GGML_USE_LLAMAFILE
-    if (!params->use_ref && src1->type != vec_dot_type) {
+    if (!params->use_ref && src1->type != vec_dot_type && ggml_cpu_sgemm_type_enabled(src0->type)) {
         const void* wdata = (src1->type == vec_dot_type) ? src1->data : params->wdata;
         const size_t row_size = ggml_row_size(vec_dot_type, ne10);
 
@@ -4088,6 +4148,10 @@ void ggml_cpu_init(void) {
 
             const uint64_t t_end = ggml_time_us(); UNUSED(t_end);
 
+#ifdef GGML_USE_LLAMAFILE
+            ggml_cpu_sgemm_types_init();
+#endif
+
             GGML_PRINT_DEBUG("%s: GELU, Quick GELU, SILU and EXP tables initialized in %f ms\n", __func__, (t_end - t_start)/1000.0);
 
 #ifdef GGML_USE_OPENMP
