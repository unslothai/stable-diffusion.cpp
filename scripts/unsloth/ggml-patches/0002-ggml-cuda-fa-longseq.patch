+// Long-sequence variant of the kernels without GQA packing (ncols2 == 1) and without a mask, used for diffusion models.
+// The stock ncols2 == 1 kernels load K/V synchronously with an out-of-bounds check on every KV tile because the
+// KV length need not be a multiple of nbatch_fa. The long-sequence variant pipelines all full KV tiles with cp.async
+// and only loads the final, partial tile synchronously with the OOB check. The arithmetic per output element is the
+// same as in the stock kernel, so the results are bit-identical.
+static __host__ int ggml_cuda_fattn_mma_get_nstages_longseq(const int DKQ, const int DV, const int ncols, const int cc) {
+    return cp_async_available(cc) ? ggml_cuda_fattn_mma_get_nstages_target(DKQ, DV, ncols, cc) : 0;
+}
+
+static constexpr __device__ int ggml_cuda_fattn_mma_get_nstages_longseq(const int DKQ, const int DV, const int ncols) {
+#ifdef CP_ASYNC_AVAILABLE
+    return ggml_cuda_fattn_mma_get_nstages_target(DKQ, DV, ncols);
+#else
+    GGML_UNUSED_VARS(DKQ, DV, ncols);
+    return 0;
+#endif // CP_ASYNC_AVAILABLE
+}
