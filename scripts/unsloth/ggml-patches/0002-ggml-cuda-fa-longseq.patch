+                const int    nstages_stock      = ggml_cuda_fattn_mma_get_nstages(DKQ, DV, ncols1, ncols2, cc);
+                const size_t nbytes_KV_stock    = nstages_stock <= 1 ? nbytes_shared_KV_1stage : nbytes_shared_KV_2stage;
+                const size_t nbytes_total_stock = std::max(nbytes_shared_combine, Q_in_reg ?
+                    std::max(nbytes_shared_Q,  nbytes_KV_stock + nbytes_shared_mask) :
+                             nbytes_shared_Q + nbytes_KV_stock + nbytes_shared_mask);
+                fattn_kernel_t stock_kernel = flash_attn_ext_f16<DKQ, DV, ncols1, ncols2, false, false, false>;
