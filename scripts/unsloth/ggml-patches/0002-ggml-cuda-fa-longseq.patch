From 7f7c132c57dbfd8fd44a13dd29031c6724589efc Mon Sep 17 00:00:00 2001
From: Daniel Han <danielhanchen@gmail.com>
Date: Thu, 1 Oct 2026 06:27:44 -0700
Subject: [PATCH 2/3] ggml-cuda: per-architecture tile width for the
 long-sequence FlashAttention variant

Use 128 Q columns per block (8 warps sharing each K/V tile) by default for head
size 128 on sm80 and sm89, where it was measured faster at MiniMax-H3 DiT shapes
(A100: 75 -> 70 ms, L4: 460 -> 365 ms per 19108-token, 56-head call); keep 64
elsewhere (neutral on sm100/sm120, slower for head size 64 on A100).
GGML_CUDA_FA_LONGSEQ_NCOLS=64|128 overrides.
---
 src/ggml-cuda/fattn-mma-f16.cuh | 13 ++++++++-----
 src/ggml-cuda/fattn.cu          |  2 +-
 2 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/src/ggml-cuda/fattn-mma-f16.cuh b/src/ggml-cuda/fattn-mma-f16.cuh
index b4496734..57f284c6 100644
--- a/src/ggml-cuda/fattn-mma-f16.cuh
+++ b/src/ggml-cuda/fattn-mma-f16.cuh
@@ -1965,9 +1965,11 @@ static bool ggml_cuda_fattn_mma_longseq_arch_default(const int cc) {
     return true;
 }
 
-// Q columns per CUDA block of the long-sequence variant for long Q: 64 (the stock tile) or 128 (8 warps sharing each K/V tile).
-// GGML_CUDA_FA_LONGSEQ_NCOLS=64|128 overrides the per-architecture default.
-static int ggml_cuda_fattn_mma_longseq_ncols(const int cc) {
+// Q columns per CUDA block of the long-sequence variant for long Q: 64 (the stock tile) or 128 (8 warps sharing each K/V tile,
+// half the K/V traffic per FLOP). GGML_CUDA_FA_LONGSEQ_NCOLS=64|128 overrides the per-architecture default.
+// Measured at MiniMax-H3 DiT shapes (19108 tokens, 56 heads x 128): 128 is faster on A100 (sm80) and L4 (sm89), neutral on
+// RTX PRO 6000 Blackwell (sm120) and B200 (sm100), and slower for head size 64 on A100, so it is only the default there.
+static int ggml_cuda_fattn_mma_longseq_ncols(const int cc, const int DKQ) {
     static const int env = [] {
         const char * e = getenv("GGML_CUDA_FA_LONGSEQ_NCOLS");
         return e != nullptr ? atoi(e) : -1;
@@ -1975,8 +1977,9 @@ static int ggml_cuda_fattn_mma_longseq_ncols(const int cc) {
     if (env == 64 || env == 128) {
         return env;
     }
-    GGML_UNUSED(cc);
-    return 64;
+    const int arch = ggml_cuda_highest_compiled_arch(cc);
+    return DKQ == 128 && (cc == GGML_CUDA_CC_AMPERE || cc == GGML_CUDA_CC_ADA_LOVELACE) &&
+        (arch == GGML_CUDA_CC_AMPERE || arch == GGML_CUDA_CC_ADA_LOVELACE) ? 128 : 64;
 }
 
 static bool ggml_cuda_fattn_mma_use_longseq(const int cc, const ggml_tensor * dst) {
diff --git a/src/ggml-cuda/fattn.cu b/src/ggml-cuda/fattn.cu
index 00e9554a..b8be30a0 100644
--- a/src/ggml-cuda/fattn.cu
+++ b/src/ggml-cuda/fattn.cu
@@ -32,7 +32,7 @@ static void ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1(ggml_backend_cuda_con
 
 #if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
     if constexpr (ncols2 == 1 && DKQ == DV && (DKQ == 64 || DKQ == 128)) {
-        if (Q->ne[1] >= 1024 && ggml_cuda_fattn_mma_longseq_ncols(cc) == 128 && ggml_cuda_fattn_mma_use_longseq(cc, dst)) {
+        if (Q->ne[1] >= 1024 && ggml_cuda_fattn_mma_longseq_ncols(cc, DKQ) == 128 && ggml_cuda_fattn_mma_use_longseq(cc, dst)) {
             ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 128, 1>(ctx, dst);
             return;
         }
