+// Whether the long-sequence variant (see ggml_cuda_fattn_mma_get_nstages_longseq) can and should be used for dst.
+// GGML_CUDA_FA_LONGSEQ=0 disables it, =1 enables it on every NVIDIA GPU with cp.async, unset = per-architecture default.
+static bool ggml_cuda_fattn_mma_longseq_arch_default(const int cc) {
+    GGML_UNUSED(cc);
+    return true;
+}
+
+// Q columns per CUDA block of the long-sequence variant for long Q: 64 (the stock tile) or 128 (8 warps sharing each K/V tile).
+// GGML_CUDA_FA_LONGSEQ_NCOLS=64|128 overrides the per-architecture default.
+static int ggml_cuda_fattn_mma_longseq_ncols(const int cc) {
+    static const int env = [] {
+        const char * e = getenv("GGML_CUDA_FA_LONGSEQ_NCOLS");
+        return e != nullptr ? atoi(e) : -1;
+    }();
+    if (env == 64 || env == 128) {
+        return env;
+    }
+    GGML_UNUSED(cc);
+    return 64;
+}
+
+static bool ggml_cuda_fattn_mma_use_longseq(const int cc, const ggml_tensor * dst) {
+    static const int env = [] {
+        const char * e = getenv("GGML_CUDA_FA_LONGSEQ");
+        return e != nullptr ? atoi(e) : -1;
+    }();
+    if (env == 0 || !GGML_CUDA_CC_IS_NVIDIA(cc) || !cp_async_available(cc)) {
+        return false;
+    }
+    const ggml_tensor * K     = dst->src[1];
+    const ggml_tensor * V     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    float logit_softcap;
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (mask != nullptr || sinks != nullptr || logit_softcap != 0.0f || K->ne[0] != V->ne[0] || K->ne[1] < 256) {
+        return false;
+    }
+    return env == 1 || ggml_cuda_fattn_mma_longseq_arch_default(cc);
+}
