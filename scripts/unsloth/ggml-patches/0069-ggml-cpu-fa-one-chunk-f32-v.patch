diff --git a/tests/test-fa-f16-v-accum.cpp b/tests/test-fa-f16-v-accum.cpp
new file mode 100644
index 0000000..526c751
--- /dev/null
+++ b/tests/test-fa-f16-v-accum.cpp
@@ -0,0 +1,121 @@
+// test-fa-f16-v-accum.cpp: validate the CPU flash attention kernel that runs when the query count is below the
+// tile size (one-chunk kernel) for an F16 V cache against a double-precision reference.
+//
+// test-backend-ops uses the CPU backend as its reference, so it cannot see an error in the CPU kernel itself.
+// The one-chunk kernel used to keep the running V sum of an F16 V cache in F16 and normalize it only at the
+// end: with enough keys the unnormalized sum passes 65504 and the output is inf even though every V value and
+// the true output are small. The cases cover that overflow, random data, head sizes that leave a vector tail,
+// and several thread counts.
+
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+static uint64_t g_rng = 0x9e3779b97f4a7c15ULL;
+static float frand(void) {
+    g_rng = g_rng * 6364136223846793005ULL + 1442695040888963407ULL;
+    return (float)((g_rng >> 33) & 0xffffff) / (float)0x800000 - 1.0f;
+}
+
+// One case: n_q queries, n_kv keys, one head. q_scale / v_base / v_scale shape the data.
+static int run_case(const char * name, int64_t D, int64_t DV, int64_t n_q, int64_t n_kv, float q_scale, float v_base,
+                    float v_scale, int n_threads) {
+    struct ggml_init_params params = {
+        /* .mem_size   = */ (size_t) 256 << 20,
+        /* .mem_base   = */ NULL,
+        /* .no_alloc   = */ false,
+    };
+    struct ggml_context * ctx = ggml_init(params);
+
+    struct ggml_tensor * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, D, n_q, 1, 1);
+    struct ggml_tensor * k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, D, n_kv, 1, 1);
+    struct ggml_tensor * v = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, DV, n_kv, 1, 1);
+
+    std::vector<double> qd(D * n_q), kd(D * n_kv), vd(DV * n_kv);
+    for (int64_t i = 0; i < D * n_q; i++) {
+        const float x = q_scale * frand();
+        ((float *) q->data)[i] = x;
+        qd[i] = ggml_fp16_to_fp32(ggml_fp32_to_fp16(x)); // the kernel rounds Q to the K type (F16) for the dot
+    }
+    for (int64_t i = 0; i < D * n_kv; i++) {
+        const ggml_fp16_t h = ggml_fp32_to_fp16(frand());
+        ((ggml_fp16_t *) k->data)[i] = h;
+        kd[i] = ggml_fp16_to_fp32(h);
+    }
+    for (int64_t i = 0; i < DV * n_kv; i++) {
+        const ggml_fp16_t h = ggml_fp32_to_fp16(v_base + v_scale * frand());
+        ((ggml_fp16_t *) v->data)[i] = h;
+        vd[i] = ggml_fp16_to_fp32(h);
+    }
+
+    const float scale = 1.0f / sqrtf((float) D);
+    struct ggml_tensor * out = ggml_flash_attn_ext(ctx, q, k, v, NULL, scale, 0.0f, 0.0f);
+    ggml_flash_attn_ext_set_prec(out, GGML_PREC_F32);
+
+    struct ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, out);
+    ggml_graph_compute_with_ctx(ctx, gf, n_threads);
+
+    // out: [DV, n_head, n_q, 1]
+    int    bad     = 0;
+    double max_err = 0.0;
+    std::vector<double> s(n_kv);
+    for (int64_t iq = 0; iq < n_q; iq++) {
+        double m = -INFINITY;
+        for (int64_t ik = 0; ik < n_kv; ik++) {
+            double d = 0.0;
+            for (int64_t c = 0; c < D; c++) {
+                d += qd[iq * D + c] * kd[ik * D + c];
+            }
+            s[ik] = d * scale;
+            m     = std::fmax(m, s[ik]);
+        }
+        double sum = 0.0;
+        for (int64_t ik = 0; ik < n_kv; ik++) {
+            s[ik] = std::exp(s[ik] - m);
+            sum += s[ik];
+        }
+        for (int64_t c = 0; c < DV; c++) {
+            double ref = 0.0;
+            for (int64_t ik = 0; ik < n_kv; ik++) {
+                ref += s[ik] * vd[ik * DV + c];
+            }
+            ref /= sum;
+            const float  y   = ((const float *) out->data)[iq * DV + c];
+            const double err = std::fabs((double) y - ref) / (1.0 + std::fabs(ref));
+            if (!std::isfinite(y) || err > 2e-3) {
+                if (bad < 3) {
+                    printf("  %s: q %d dim %d = %g, expected %g\n", name, (int) iq, (int) c, y, ref);
+                }
+                bad++;
+            } else {
+                max_err = std::fmax(max_err, err);
+            }
+        }
+    }
+    printf("%-34s D=%3d DV=%3d n_q=%2d n_kv=%5d t=%d: max err %.2e, %d mismatches %s\n", name, (int) D, (int) DV, (int) n_q,
+           (int) n_kv, n_threads, max_err, bad, bad == 0 ? "OK" : "FAIL");
+    ggml_free(ctx);
+    return bad;
+}
+
+int main(void) {
+    int bad = 0;
+    for (int nt : { 1, 4 }) {
+        // V sum past the F16 range: uniform-ish scores (small Q), V near 300, 400 to 4000 keys (sum 1.2e5 to 1.2e6)
+        bad += run_case("f16 V overflow", 64, 64, 1, 400, 0.01f, 300.0f, 10.0f, nt);
+        bad += run_case("f16 V overflow", 128, 128, 4, 4000, 0.01f, 300.0f, 10.0f, nt);
+        bad += run_case("f16 V overflow, DV tail", 80, 80, 3, 1000, 0.01f, -200.0f, 50.0f, nt);
+        // ordinary data
+        bad += run_case("random", 64, 64, 2, 256, 1.0f, 0.0f, 1.0f, nt);
+        bad += run_case("random, DV tail", 72, 72, 5, 333, 2.0f, 0.0f, 4.0f, nt);
+        bad += run_case("random, long", 128, 128, 1, 2048, 1.0f, 0.0f, 1.0f, nt);
+    }
+    printf("%s\n", bad == 0 ? "ALL OK" : "FAILED");
+    return bad == 0 ? 0 : 1;
+}
