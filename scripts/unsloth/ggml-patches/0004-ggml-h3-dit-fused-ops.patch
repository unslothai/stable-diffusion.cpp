+struct ggml_tensor * ggml_rope_pe_permute(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * pe,
+        int                   n_rot,
+        float                 scale,
+        enum ggml_type        type) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32);
+    GGML_ASSERT(a->nb[0] == ggml_type_size(a->type));
+    GGML_ASSERT(type == GGML_TYPE_F32 || type == GGML_TYPE_F16);
+    GGML_ASSERT(n_rot >= 0 && n_rot % 2 == 0 && n_rot <= a->ne[0]);
+    if (n_rot > 0) {
+        GGML_ASSERT(pe != NULL && pe->type == GGML_TYPE_F32 && ggml_is_contiguous(pe));
+        GGML_ASSERT(pe->ne[0] == 2 && pe->ne[1] == 2 && pe->ne[2] == n_rot / 2 && pe->ne[3] == a->ne[2]);
+    } else {
+        GGML_ASSERT(pe == NULL);
+    }
+    GGML_ASSERT(isfinite(scale));
+
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, type, a->ne[0], a->ne[2], a->ne[1], a->ne[3]);
+
+    ggml_set_op_params_i32(result, 0, n_rot);
+    ggml_set_op_params_f32(result, 1, scale);
+
+    result->op     = GGML_OP_ROPE_PE_PERMUTE;
+    result->src[0] = a;
+    result->src[1] = pe;
+
+    return result;
+}
+
+static struct ggml_tensor * ggml_modulate_rows_impl(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * acc,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * c,
+        int64_t               row0,
+        int64_t               row1,
+        float                 s,
+        int32_t               mode) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && a->nb[0] == sizeof(float));
+    GGML_ASSERT(row0 >= 0 && row0 < row1 && row1 <= a->ne[1] && row1 <= INT32_MAX);
+    GGML_ASSERT(isfinite(s));
+    // mode 0: a = x, b = scale, c = shift; mode 1: a = base, b = u, c = gate
+    struct ggml_tensor * vec0 = mode == 0 ? b : c;
+    GGML_ASSERT(vec0->type == GGML_TYPE_F32 && vec0->nb[0] == sizeof(float) && ggml_nelements(vec0) == a->ne[0]);
+    if (mode == 0) {
+        GGML_ASSERT(c->type == GGML_TYPE_F32 && c->nb[0] == sizeof(float) && ggml_nelements(c) == a->ne[0]);
+    } else {
+        GGML_ASSERT(b->type == GGML_TYPE_F32 && b->nb[0] == sizeof(float) && ggml_are_same_shape(a, b));
+    }
+    if (acc != NULL) {
+        GGML_ASSERT(acc->type == GGML_TYPE_F32 && ggml_is_contiguous(acc) && ggml_are_same_shape(acc, a));
+    }
+
+    struct ggml_tensor * result = acc != NULL ? ggml_view_tensor(ctx, acc) : ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, a->ne);
+
+    ggml_set_op_params_i32(result, 0, mode);
+    ggml_set_op_params_i32(result, 1, (int32_t) row0);
+    ggml_set_op_params_i32(result, 2, (int32_t) row1);
+    ggml_set_op_params_f32(result, 3, s);
+
+    result->op     = GGML_OP_MODULATE_ROWS;
+    result->src[0] = a;
+    result->src[1] = b;
+    result->src[2] = c;
+    result->src[3] = acc;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_modulate_rows(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * acc,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * scale,
+        struct ggml_tensor  * shift,
+        int64_t               row0,
+        int64_t               row1,
+        float                 out_scale) {
+    return ggml_modulate_rows_impl(ctx, acc, x, scale, shift, row0, row1, out_scale, 0);
+}
+
+struct ggml_tensor * ggml_gated_add_rows(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * acc,
+        struct ggml_tensor  * base,
+        struct ggml_tensor  * u,
+        struct ggml_tensor  * gate,
+        int64_t               row0,
+        int64_t               row1,
+        float                 u_scale) {
+    return ggml_modulate_rows_impl(ctx, acc, base, u, gate, row0, row1, u_scale, 1);
+}
+
+struct ggml_tensor * ggml_swiglu_scaled(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        float                 in_scale,
+        float                 out_scale) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && b->type == GGML_TYPE_F32);
+    GGML_ASSERT(a->nb[0] == sizeof(float) && b->nb[0] == sizeof(float));
+    GGML_ASSERT(ggml_are_same_shape(a, b));
+    GGML_ASSERT(isfinite(in_scale) && isfinite(out_scale));
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, a->ne);
+
+    ggml_set_op_params_f32(result, 0, in_scale);
+    ggml_set_op_params_f32(result, 1, out_scale);
+
+    result->op     = GGML_OP_SWIGLU_SCALED;
+    result->src[0] = a;
+    result->src[1] = b;
+
+    return result;
+}
