 src/ggml-cuda/rope-pe.cu        | 102 +++++++++++++++++++
 src/ggml-cuda/rope-pe.cuh       |   5 +
 src/ggml.c                      | 129 +++++++++++++++++++++++-
 tests/test-backend-ops.cpp      | 139 ++++++++++++++++++++++++++
