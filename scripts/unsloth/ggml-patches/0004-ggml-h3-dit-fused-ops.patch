diff --git a/src/ggml-cuda/modulate-rows.cu b/src/ggml-cuda/modulate-rows.cu
new file mode 100644
index 00000000..1b639d28
--- /dev/null
+++ b/src/ggml-cuda/modulate-rows.cu
@@ -0,0 +1,168 @@
+#include "modulate-rows.cuh"
+#include "unary.cuh"
+
+// Rounding matches the unfused graph: __fmul_rn/__fadd_rn are the separately rounded MUL and ADD
+// kernels (never contracted into an FMA), `s*y + bias` is the expression the SCALE kernel
+// evaluates, and the swiglu product is the GLU kernel's silu(a)*b.
+
+template <int mode, bool has_scale>
+static __global__ void modulate_rows_kernel(
+        const char * __restrict__ a, const char * __restrict__ b, const char * __restrict__ c, char * __restrict__ dst,
+        const int nc, const int64_t nr1, const int64_t ne2, const int64_t row0,
+        const int64_t nba1, const int64_t nba2, const int64_t nba3,
+        const int64_t nbb1, const int64_t nbb2, const int64_t nbb3,
+        const int64_t nbd1, const int64_t nbd2, const int64_t nbd3,
+        const float s, const float bias) {
+    const int64_t ir = blockIdx.x;
+    const int64_t i1 = row0 + ir % nr1;
+    const int64_t i2 = (ir / nr1) % ne2;
+    const int64_t i3 = ir / (nr1 * ne2);
+
+    const float * xa = (const float *) (a + i1 * nba1 + i2 * nba2 + i3 * nba3);
+    float       * y  = (float *) (dst + i1 * nbd1 + i2 * nbd2 + i3 * nbd3);
+
+    if constexpr (mode == 0) {
+        const float * scale = (const float *) b;
+        const float * shift = (const float *) c;
+        for (int i = threadIdx.x; i < nc; i += blockDim.x) {
+            const float x = xa[i];
+            float v = __fadd_rn(__fadd_rn(x, __fmul_rn(x, scale[i])), shift[i]);
+            if constexpr (has_scale) {
+                v = s * v + bias;
+            }
+            y[i] = v;
+        }
+    } else {
+        const float * u    = (const float *) (b + i1 * nbb1 + i2 * nbb2 + i3 * nbb3);
+        const float * gate = (const float *) c;
+        for (int i = threadIdx.x; i < nc; i += blockDim.x) {
+            float w = u[i];
+            if constexpr (has_scale) {
+                w = s * w + bias;
+            }
+            y[i] = __fadd_rn(xa[i], __fmul_rn(w, gate[i]));
+        }
+    }
+}
+
+void ggml_cuda_op_modulate_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * a = dst->src[0];
+    const ggml_tensor * b = dst->src[1];
+    const ggml_tensor * c = dst->src[2];
+
+    const int     mode = ggml_get_op_params_i32(dst, 0);
+    const int64_t row0 = ggml_get_op_params_i32(dst, 1);
+    const int64_t row1 = ggml_get_op_params_i32(dst, 2);
+    const float   s    = ggml_get_op_params_f32(dst, 3);
+
+    const int64_t nr1   = row1 - row0;
+    const int64_t nrows = nr1 * a->ne[2] * a->ne[3];
+    const int     nc    = (int) a->ne[0];
+    if (nrows == 0) {
+        return;
+    }
+
+    cudaStream_t stream = ctx.stream();
+    const dim3   grid((unsigned int) nrows, 1, 1);
+    const dim3   block(256, 1, 1);
+
+#define MODULATE_ROWS_LAUNCH(MODE, HAS_SCALE)                                                                   \
+    modulate_rows_kernel<MODE, HAS_SCALE><<<grid, block, 0, stream>>>(                                          \
+        (const char *) a->data, (const char *) b->data, (const char *) c->data, (char *) dst->data, nc, nr1,    \
+        a->ne[2], row0, a->nb[1], a->nb[2], a->nb[3], b->nb[1], b->nb[2], b->nb[3], dst->nb[1], dst->nb[2],     \
+        dst->nb[3], s, 0.0f)
+
+    if (mode == 0) {
+        if (s != 1.0f) {
+            MODULATE_ROWS_LAUNCH(0, true);
+        } else {
+            MODULATE_ROWS_LAUNCH(0, false);
+        }
+    } else {
+        if (s != 1.0f) {
+            MODULATE_ROWS_LAUNCH(1, true);
+        } else {
+            MODULATE_ROWS_LAUNCH(1, false);
+        }
+    }
+#undef MODULATE_ROWS_LAUNCH
+}
+
+bool ggml_cuda_modulate_rows_supported(const ggml_tensor * op) {
+    const int64_t nrows = (int64_t) (ggml_get_op_params_i32(op, 2) - ggml_get_op_params_i32(op, 1)) * op->src[0]->ne[2] * op->src[0]->ne[3];
+    return op->type == GGML_TYPE_F32 && ggml_is_contiguous_rows(op) && op->src[0]->ne[0] <= INT_MAX && nrows <= INT_MAX &&
+           ggml_is_contiguous(op->src[ggml_get_op_params_i32(op, 0) == 0 ? 1 : 2]) &&
+           (ggml_get_op_params_i32(op, 0) != 0 || ggml_is_contiguous(op->src[2]));
+}
+
+template <bool has_in, bool has_out>
+static __global__ void swiglu_scaled_kernel(
+        const char * __restrict__ a, const char * __restrict__ b, float * __restrict__ dst,
+        const int nc, const int64_t ne1, const int64_t ne2,
+        const int64_t nba1, const int64_t nba2, const int64_t nba3,
+        const int64_t nbb1, const int64_t nbb2, const int64_t nbb3,
+        const float in_scale, const float out_scale, const float bias) {
+    const int64_t ir = blockIdx.x;
+    const int64_t i1 = ir % ne1;
+    const int64_t i2 = (ir / ne1) % ne2;
+    const int64_t i3 = ir / (ne1 * ne2);
+
+    const float * xa = (const float *) (a + i1 * nba1 + i2 * nba2 + i3 * nba3);
+    const float * xb = (const float *) (b + i1 * nbb1 + i2 * nbb2 + i3 * nbb3);
+    float       * y  = dst + ir * nc;
+
+    for (int i = threadIdx.x; i < nc; i += blockDim.x) {
+        float va = xa[i];
+        float vb = xb[i];
+        if constexpr (has_in) {
+            va = in_scale * va + bias;
+            vb = in_scale * vb + bias;
+        }
+        float v = ggml_cuda_op_silu_single(va) * vb;
+        if constexpr (has_out) {
+            v = out_scale * v + bias;
+        }
+        y[i] = v;
+    }
+}
+
+void ggml_cuda_op_swiglu_scaled(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * a = dst->src[0];
+    const ggml_tensor * b = dst->src[1];
+
+    const float in_scale  = ggml_get_op_params_f32(dst, 0);
+    const float out_scale = ggml_get_op_params_f32(dst, 1);
+
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    const int64_t nrows = ggml_nrows(a);
+    const int     nc    = (int) a->ne[0];
+    if (nrows == 0) {
+        return;
+    }
+
+    cudaStream_t stream = ctx.stream();
+    const dim3   grid((unsigned int) nrows, 1, 1);
+    const dim3   block(256, 1, 1);
+
+#define SWIGLU_SCALED_LAUNCH(HAS_IN, HAS_OUT)                                                                  \
+    swiglu_scaled_kernel<HAS_IN, HAS_OUT><<<grid, block, 0, stream>>>(                                         \
+        (const char *) a->data, (const char *) b->data, (float *) dst->data, nc, a->ne[1], a->ne[2], a->nb[1], \
+        a->nb[2], a->nb[3], b->nb[1], b->nb[2], b->nb[3], in_scale, out_scale, 0.0f)
+
+    const bool has_in  = in_scale != 1.0f;
+    const bool has_out = out_scale != 1.0f;
+    if (has_in && has_out) {
+        SWIGLU_SCALED_LAUNCH(true, true);
+    } else if (has_in) {
+        SWIGLU_SCALED_LAUNCH(true, false);
+    } else if (has_out) {
+        SWIGLU_SCALED_LAUNCH(false, true);
+    } else {
+        SWIGLU_SCALED_LAUNCH(false, false);
+    }
+#undef SWIGLU_SCALED_LAUNCH
+}
+
+bool ggml_cuda_swiglu_scaled_supported(const ggml_tensor * op) {
+    return op->type == GGML_TYPE_F32 && op->src[0]->ne[0] <= INT_MAX && ggml_nrows(op->src[0]) <= INT_MAX;
+}
