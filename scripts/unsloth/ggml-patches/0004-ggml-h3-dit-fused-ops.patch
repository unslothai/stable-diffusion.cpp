diff --git a/include/ggml.h b/include/ggml.h
index 991cc4fc..153eed2a 100644
--- a/include/ggml.h
+++ b/include/ggml.h
@@ -594,6 +594,9 @@ extern "C" {
 
         GGML_OP_QUANTIZE_I8_CONVROT,
         GGML_OP_SAGE_ATTN,
+        GGML_OP_ROPE_PE_PERMUTE,
+        GGML_OP_MODULATE_ROWS,
+        GGML_OP_SWIGLU_SCALED,
 
         GGML_OP_COUNT,
     };
@@ -2461,6 +2464,65 @@ extern "C" {
             float                 scale,
             enum ggml_sage_attn_mode mode);
 
+    // Rotary embedding with a precomputed cos/sin table, fused with the head-major relayout
+    // attention kernels consume, an optional scale and an optional cast to F16.
+    // a:      F32 [head_dim, n_head, n_tokens, n_batch], rows contiguous (other strides free)
+    // pe:     F32 contiguous [2, 2, n_rot/2, n_tokens], pe[c, r, j, t] = M[r][c] of the 2x2 rotation
+    //         for pair j of token t (non-interleaved pairing j <-> j + n_rot/2); NULL when n_rot == 0
+    // result: `type` (F32 or F16) contiguous [head_dim, n_tokens, n_head, n_batch]
+    //         i <  n_rot: y = a[j]*pe[0, r, j, t] + a[j + n_rot/2]*pe[1, r, j, t] (r = i / (n_rot/2), j = i % (n_rot/2))
+    //         i >= n_rot: y = a[i]
+    //         y = scale*y when scale != 1, then y is converted to `type`.
+    // Each product, the sum, the scale and the conversion are rounded separately, so the result
+    // matches the equivalent chain of ggml_mul/ggml_add/ggml_concat/ggml_scale/ggml_cpy bit for bit.
+    GGML_API struct ggml_tensor * ggml_rope_pe_permute(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * pe,
+            int                   n_rot,
+            float                 scale,
+            enum ggml_type        type);
+
+    // Row-range modulation for adaLN-style blocks whose sequence is split into segments that use
+    // different modulation vectors. Writes rows [row0, row1) along dim 1 (all of dims 2 and 3) of the
+    // result and leaves every other row as it is in `acc`: chain one call per segment, passing the
+    // previous result as `acc` (written in place); the first call passes acc = NULL and gets a new
+    // tensor shaped like x / base. x, base, u: F32 with contiguous rows; scale, shift, gate: F32
+    // with ne[0] == x->ne[0] elements, broadcast over rows.
+    //   ggml_modulate_rows:  y = (x + x*scale) + shift; then y = out_scale*y when out_scale != 1
+    //   ggml_gated_add_rows: w = u_scale*u when u_scale != 1 (else u); y = base + w*gate
+    // Each product, sum and scale is rounded separately, so the result equals the slice +
+    // ggml_mul/ggml_add/ggml_scale + ggml_concat chain bit for bit.
+    GGML_API struct ggml_tensor * ggml_modulate_rows(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * acc,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * scale,
+            struct ggml_tensor  * shift,
+            int64_t               row0,
+            int64_t               row1,
+            float                 out_scale);
+
+    GGML_API struct ggml_tensor * ggml_gated_add_rows(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * acc,
+            struct ggml_tensor  * base,
+            struct ggml_tensor  * u,
+            struct ggml_tensor  * gate,
+            int64_t               row0,
+            int64_t               row1,
+            float                 u_scale);
+
+    // swiglu on two separately scaled halves, then scaled: with a' = in_scale*a, b' = in_scale*b,
+    // y = out_scale*(silu(a')*b') (each scale skipped when it is 1). a, b: F32, same shape, rows
+    // contiguous. Matches ggml_scale -> ggml_swiglu_split -> ggml_scale bit for bit.
+    GGML_API struct ggml_tensor * ggml_swiglu_scaled(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * b,
+            float                 in_scale,
+            float                 out_scale);
+
     GGML_API void ggml_flash_attn_ext_set_prec(
             struct ggml_tensor * a,
             enum ggml_prec       prec);
