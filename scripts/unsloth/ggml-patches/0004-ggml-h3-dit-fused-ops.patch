diff --git a/src/ggml-cuda/rope-pe.cu b/src/ggml-cuda/rope-pe.cu
new file mode 100644
index 00000000..3afe4423
--- /dev/null
+++ b/src/ggml-cuda/rope-pe.cu
@@ -0,0 +1,102 @@
+#include "rope-pe.cuh"
+#include "convert.cuh"
+
+// Fused rotary embedding (precomputed cos/sin table) + head-major relayout + scale + cast.
+// One block per (token, batch); the block walks every head so the table entries are read once.
+// Rounding matches the unfused graph exactly: __fmul_rn/__fadd_rn keep the two products and the
+// sum as separately rounded operations (no FMA contraction), the scale is the same `scale*y + bias`
+// expression the SCALE kernel evaluates, and the conversion uses the same ggml_cuda_cast as CPY.
+template <typename dst_t, bool has_scale>
+static __global__ void rope_pe_permute_kernel(
+        const char * __restrict__ x, const float * __restrict__ pe, dst_t * __restrict__ dst,
+        const int D, const int H, const int64_t L, const int n_rot,
+        const int64_t nb01, const int64_t nb02, const int64_t nb03,
+        const float scale, const float bias) {
+    const int64_t l    = blockIdx.x;
+    const int64_t n    = blockIdx.y;
+    const int     half = n_rot / 2;
+
+    for (int i = threadIdx.x; i < D; i += blockDim.x) {
+        const bool rot = i < n_rot;
+        int   j  = i;
+        float c0 = 0.0f;
+        float c1 = 0.0f;
+        if (rot) {
+            const int r = i >= half;
+            j           = i - r * half;
+            const float * t = pe + (l * half + j) * 4 + 2 * r;
+            c0 = t[0];
+            c1 = t[1];
+        }
+        for (int h = 0; h < H; ++h) {
+            const float * xr = (const float *) (x + h * nb01 + l * nb02 + n * nb03);
+            float y;
+            if (rot) {
+                y = __fadd_rn(__fmul_rn(xr[j], c0), __fmul_rn(xr[j + half], c1));
+            } else {
+                y = xr[i];
+            }
+            if constexpr (has_scale) {
+                y = scale * y + bias;
+            }
+            dst[((n * H + h) * L + l) * D + i] = ggml_cuda_cast<dst_t>(y);
+        }
+    }
+}
+
+template <typename dst_t>
+static void rope_pe_permute_cuda(const ggml_tensor * src0, const float * pe, dst_t * dst, const int n_rot,
+                                 const float scale, cudaStream_t stream) {
+    const int     D = (int) src0->ne[0];
+    const int     H = (int) src0->ne[1];
+    const int64_t L = src0->ne[2];
+    const int64_t N = src0->ne[3];
+
+    const dim3 grid((unsigned int) L, (unsigned int) N, 1);
+    const dim3 block(D >= 128 ? 128 : ((D + 31) / 32) * 32, 1, 1);
+    const char * x = (const char *) src0->data;
+    if (scale != 1.0f) {
+        rope_pe_permute_kernel<dst_t, true><<<grid, block, 0, stream>>>(
+            x, pe, dst, D, H, L, n_rot, src0->nb[1], src0->nb[2], src0->nb[3], scale, 0.0f);
+    } else {
+        rope_pe_permute_kernel<dst_t, false><<<grid, block, 0, stream>>>(
+            x, pe, dst, D, H, L, n_rot, src0->nb[1], src0->nb[2], src0->nb[3], scale, 0.0f);
+    }
+}
+
+void ggml_cuda_op_rope_pe_permute(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * pe   = dst->src[1];
+
+    const int   n_rot = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && src0->nb[0] == sizeof(float));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    GGML_ASSERT(n_rot == 0 || (pe != nullptr && ggml_is_contiguous(pe)));
+
+    cudaStream_t  stream = ctx.stream();
+    const float * pe_d   = pe ? (const float *) pe->data : nullptr;
+
+    if (dst->type == GGML_TYPE_F16) {
+        rope_pe_permute_cuda(src0, pe_d, (half *) dst->data, n_rot, scale, stream);
+    } else {
+        GGML_ASSERT(dst->type == GGML_TYPE_F32);
+        rope_pe_permute_cuda(src0, pe_d, (float *) dst->data, n_rot, scale, stream);
+    }
+}
+
+bool ggml_cuda_rope_pe_permute_supported(const ggml_tensor * op) {
+    const ggml_tensor * src0 = op->src[0];
+    const ggml_tensor * pe   = op->src[1];
+    if (src0->type != GGML_TYPE_F32 || src0->nb[0] != sizeof(float)) {
+        return false;
+    }
+    if (op->type != GGML_TYPE_F32 && op->type != GGML_TYPE_F16) {
+        return false;
+    }
+    if (src0->ne[2] > INT_MAX || src0->ne[3] > 65535 || src0->ne[1] > INT_MAX || src0->ne[0] > INT_MAX) {
+        return false;
+    }
+    return pe == nullptr || (pe->type == GGML_TYPE_F32 && ggml_is_contiguous(pe));
+}
