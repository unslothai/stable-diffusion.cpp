+
+// ggml_compute_forward_rope_pe_permute
+
+void ggml_compute_forward_rope_pe_permute(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * pe   = dst->src[1];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 || dst->type == GGML_TYPE_F16);
+
+    const int   n_rot = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int   half  = n_rot / 2;
+
+    const int64_t D = src0->ne[0];
+    const int64_t H = src0->ne[1];
+    const int64_t L = src0->ne[2];
+    const int64_t N = src0->ne[3];
+
+    const int64_t nrows = H * L * N;
+    const int64_t dr    = (nrows + params->nth - 1) / params->nth;
+    const int64_t ir0   = dr * params->ith;
+    const int64_t ir1   = MIN(ir0 + dr, nrows);
+
+    // Same rounding points as the unfused graph: each product, the sum, the scale and the
+    // conversion are separate passes, so no contraction into fused multiply-adds can happen.
+    std::vector<float> p0(n_rot), p1(n_rot), y(D);
+
+    for (int64_t ir = ir0; ir < ir1; ++ir) {
+        const int64_t h = ir % H;
+        const int64_t l = (ir / H) % L;
+        const int64_t n = ir / (H * L);
+
+        const float * x = (const float *) ((const char *) src0->data + h * src0->nb[1] + l * src0->nb[2] + n * src0->nb[3]);
+
+        if (n_rot > 0) {
+            const float * t = (const float *) pe->data + l * (int64_t) half * 4;
+            for (int i = 0; i < n_rot; ++i) {
+                const int r = i / half;
+                const int j = i - r * half;
+                p0[i]       = x[j] * t[4 * j + 2 * r + 0];
+            }
+            for (int i = 0; i < n_rot; ++i) {
+                const int r = i / half;
+                const int j = i - r * half;
+                p1[i]       = x[j + half] * t[4 * j + 2 * r + 1];
+            }
+            ggml_vec_add_f32(n_rot, y.data(), p0.data(), p1.data());
+        }
+        if (D > n_rot) {
+            memcpy(y.data() + n_rot, x + n_rot, (D - n_rot) * sizeof(float));
+        }
+        if (scale != 1.0f) {
+            ggml_vec_scale_f32((int) D, y.data(), scale);
+        }
+
+        char * out = (char *) dst->data + l * dst->nb[1] + h * dst->nb[2] + n * dst->nb[3];
+        if (dst->type == GGML_TYPE_F32) {
+            memcpy(out, y.data(), D * sizeof(float));
+        } else {
+            ggml_cpu_fp32_to_fp16(y.data(), (ggml_fp16_t *) out, D);
+        }
+    }
+}
+
+// ggml_compute_forward_modulate_rows
+
+void ggml_compute_forward_modulate_rows(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * a = dst->src[0];
+    const ggml_tensor * b = dst->src[1];
+    const ggml_tensor * c = dst->src[2];
+
+    const int     mode = ggml_get_op_params_i32(dst, 0);
+    const int64_t row0 = ggml_get_op_params_i32(dst, 1);
+    const int64_t row1 = ggml_get_op_params_i32(dst, 2);
+    const float   s    = ggml_get_op_params_f32(dst, 3);
+
+    const int64_t nc    = a->ne[0];
+    const int64_t nr1   = row1 - row0;
+    const int64_t nrows = nr1 * a->ne[2] * a->ne[3];
+    const int64_t dr    = (nrows + params->nth - 1) / params->nth;
+    const int64_t ir0   = dr * params->ith;
+    const int64_t ir1   = MIN(ir0 + dr, nrows);
+
+    // separate passes keep every product, sum and scale individually rounded, as in the unfused graph
+    std::vector<float> t(nc), w(nc);
+    for (int64_t ir = ir0; ir < ir1; ++ir) {
+        const int64_t i1 = row0 + ir % nr1;
+        const int64_t i2 = (ir / nr1) % a->ne[2];
+        const int64_t i3 = ir / (nr1 * a->ne[2]);
+
+        const float * x = (const float *) ((const char *) a->data + i1 * a->nb[1] + i2 * a->nb[2] + i3 * a->nb[3]);
+        float * y       = (float *) ((char *) dst->data + i1 * dst->nb[1] + i2 * dst->nb[2] + i3 * dst->nb[3]);
+
+        if (mode == 0) {
+            ggml_vec_mul_f32((int) nc, t.data(), x, (const float *) b->data);
+            ggml_vec_add_f32((int) nc, w.data(), x, t.data());
+            ggml_vec_add_f32((int) nc, y, w.data(), (const float *) c->data);
+            if (s != 1.0f) {
+                ggml_vec_scale_f32((int) nc, y, s);
+            }
+        } else {
+            const float * u = (const float *) ((const char *) b->data + i1 * b->nb[1] + i2 * b->nb[2] + i3 * b->nb[3]);
+            memcpy(w.data(), u, nc * sizeof(float));
+            if (s != 1.0f) {
+                ggml_vec_scale_f32((int) nc, w.data(), s);
+            }
+            ggml_vec_mul_f32((int) nc, t.data(), w.data(), (const float *) c->data);
+            ggml_vec_add_f32((int) nc, y, x, t.data());
+        }
+    }
+}
+
+// ggml_compute_forward_swiglu_scaled
+
+void ggml_compute_forward_swiglu_scaled(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * a = dst->src[0];
+    const ggml_tensor * b = dst->src[1];
+
+    const float in_scale  = ggml_get_op_params_f32(dst, 0);
+    const float out_scale = ggml_get_op_params_f32(dst, 1);
+
+    const int64_t nc    = a->ne[0];
+    const int64_t nrows = ggml_nrows(a);
+    const int64_t dr    = (nrows + params->nth - 1) / params->nth;
+    const int64_t ir0   = dr * params->ith;
+    const int64_t ir1   = MIN(ir0 + dr, nrows);
+
+    std::vector<float> xa(nc), xb(nc);
+    for (int64_t ir = ir0; ir < ir1; ++ir) {
+        const int64_t i1 = ir % a->ne[1];
+        const int64_t i2 = (ir / a->ne[1]) % a->ne[2];
+        const int64_t i3 = ir / (a->ne[1] * a->ne[2]);
+
+        memcpy(xa.data(), (const char *) a->data + i1 * a->nb[1] + i2 * a->nb[2] + i3 * a->nb[3], nc * sizeof(float));
+        memcpy(xb.data(), (const char *) b->data + i1 * b->nb[1] + i2 * b->nb[2] + i3 * b->nb[3], nc * sizeof(float));
+        if (in_scale != 1.0f) {
+            ggml_vec_scale_f32((int) nc, xa.data(), in_scale);
+            ggml_vec_scale_f32((int) nc, xb.data(), in_scale);
+        }
+        float * y = (float *) ((char *) dst->data + i1 * dst->nb[1] + i2 * dst->nb[2] + i3 * dst->nb[3]);
+        ggml_vec_swiglu_f32((int) nc, y, xa.data(), xb.data());
+        if (out_scale != 1.0f) {
+            ggml_vec_scale_f32((int) nc, y, out_scale);
+        }
+    }
+}
