+// src1 is one value per row (ne10 == 1, e.g. a per-channel bias or scale over [W, H, C] activations): the same op on
+// every element, in one loop instead of one vec_binary_op_contiguous call per element.
+template <float (*op)(float, float), typename src0_t, typename src1_t, typename dst_t>
+static inline void vec_binary_op_scalar(const int64_t n, dst_t * z, const src0_t * x, const src1_t * y) {
+    constexpr auto src0_to_f32 = type_conversion_table<src0_t>::to_f32;
+    constexpr auto src1_to_f32 = type_conversion_table<src1_t>::to_f32;
+    constexpr auto f32_to_dst  = type_conversion_table<dst_t >::from_f32;
+
+    const float v = src1_to_f32(*y);
+    for (int64_t i = 0; i < n; i++) {
+        z[i] = f32_to_dst(op(src0_to_f32(x[i]), v));
+    }
+}
