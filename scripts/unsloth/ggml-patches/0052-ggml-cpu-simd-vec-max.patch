ggml_vec_max_f32: AVX512 / AVX / NEON loops instead of one scalar max per element (builds without Accelerate; Apple
keeps vDSP_maxv). The scalar loop has one dependent maxss per element, which made the per-row max of the tiled flash
attention cost about as much as its Q*K GEMM. The maximum of finite floats does not depend on the order it is taken
in, so the result is the same; only the sign of a zero maximum can differ, and every caller subtracts it or compares
with it (flash attention, SOFT_MAX, cross entropy), which gives identical results for +0 and -0.

diff --git a/src/ggml-cpu/vec.h b/src/ggml-cpu/vec.h
index 59fa88f..0bf68d5 100644
--- a/src/ggml-cpu/vec.h
+++ b/src/ggml-cpu/vec.h
@@ -1600,8 +1600,52 @@ inline static void ggml_vec_sum_bf16_ggf(const int n, float * s, const ggml_bf16
 
 inline static void ggml_vec_max_f32(const int n, float * s, const float * x) {
 #ifndef GGML_USE_ACCELERATE
+    // The maximum of a set of finite floats does not depend on the order it is taken in, so the
+    // vector loops return what the scalar loop returns (up to the sign of a zero maximum, which
+    // every caller only subtracts or compares). The scalar loop alone has one maxss per element
+    // on its dependency chain, which made it as slow as the Q*K GEMM in the tiled flash attention.
     float max = -INFINITY;
-    for (int i = 0; i < n; ++i) {
+    int i = 0;
+#if defined(__AVX512F__)
+    if (n >= 32) {
+        __m512 m0 = _mm512_set1_ps(-INFINITY);
+        __m512 m1 = m0;
+        for (; i + 31 < n; i += 32) {
+            m0 = _mm512_max_ps(m0, _mm512_loadu_ps(x + i));
+            m1 = _mm512_max_ps(m1, _mm512_loadu_ps(x + i + 16));
+        }
+        max = _mm512_reduce_max_ps(_mm512_max_ps(m0, m1));
+    }
+#elif defined(__AVX__)
+    if (n >= 16) {
+        __m256 m0 = _mm256_set1_ps(-INFINITY);
+        __m256 m1 = m0;
+        for (; i + 15 < n; i += 16) {
+            m0 = _mm256_max_ps(m0, _mm256_loadu_ps(x + i));
+            m1 = _mm256_max_ps(m1, _mm256_loadu_ps(x + i + 8));
+        }
+        m0 = _mm256_max_ps(m0, m1);
+        __m128 m = _mm_max_ps(_mm256_castps256_ps128(m0), _mm256_extractf128_ps(m0, 1));
+        m = _mm_max_ps(m, _mm_movehl_ps(m, m));
+        m = _mm_max_ss(m, _mm_movehdup_ps(m));
+        max = _mm_cvtss_f32(m);
+    }
+#elif defined(__ARM_NEON) && defined(__aarch64__)
+    if (n >= 16) {
+        float32x4_t m0 = vdupq_n_f32(-INFINITY);
+        float32x4_t m1 = m0;
+        float32x4_t m2 = m0;
+        float32x4_t m3 = m0;
+        for (; i + 15 < n; i += 16) {
+            m0 = vmaxq_f32(m0, vld1q_f32(x + i));
+            m1 = vmaxq_f32(m1, vld1q_f32(x + i + 4));
+            m2 = vmaxq_f32(m2, vld1q_f32(x + i + 8));
+            m3 = vmaxq_f32(m3, vld1q_f32(x + i + 12));
+        }
+        max = vmaxvq_f32(vmaxq_f32(vmaxq_f32(m0, m1), vmaxq_f32(m2, m3)));
+    }
+#endif
+    for (; i < n; ++i) {
         max = MAX(max, x[i]);
     }
     *s = max;
