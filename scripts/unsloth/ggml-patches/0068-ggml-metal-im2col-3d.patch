+int ggml_metal_op_im2col_3d(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * op = ctx->node(idx);
+
+    ggml_metal_library_t lib = ctx->lib;
+    ggml_metal_encoder_t enc = ctx->enc;
+
+    const int32_t * params = (const int32_t *) op->op_params;
+
+    const ggml_tensor * src0 = op->src[0];
+    const ggml_tensor * src1 = op->src[1];
+
+    const int32_t IC = params[9];
+    const int32_t N  = src1->ne[3] / IC;
+    const int32_t KW = src0->ne[0];
+    const int32_t KH = src0->ne[1];
+    const int32_t KD = src0->ne[2];
+    const int32_t OW = op->ne[1];
+    const int32_t OH = op->ne[2];
+    const int32_t OD = op->ne[3] / N;
+
+    const int32_t CDHW = IC * KD * KH * KW;
+
+    ggml_metal_kargs_im2col_3d args = {
+        /*.ofs_c =*/ src1->nb[3] / sizeof(float),
+        /*.ofs_d =*/ src1->nb[2] / sizeof(float),
+        /*.ofs_h =*/ src1->nb[1] / sizeof(float),
+        /*.IW    =*/ (int32_t) src1->ne[0],
+        /*.IH    =*/ (int32_t) src1->ne[1],
+        /*.ID    =*/ (int32_t) src1->ne[2],
+        /*.OD    =*/ OD,
+        /*.IC    =*/ IC,
+        /*.N     =*/ N,
+        /*.KW    =*/ KW,
+        /*.KHW   =*/ KH * KW,
+        /*.KDHW  =*/ KD * KH * KW,
+        /*.CDHW  =*/ CDHW,
+        /*.s0    =*/ params[0],
+        /*.s1    =*/ params[1],
+        /*.s2    =*/ params[2],
+        /*.p0    =*/ params[3],
+        /*.p1    =*/ params[4],
+        /*.p2    =*/ params[5],
+        /*.d0    =*/ params[6],
+        /*.d1    =*/ params[7],
+        /*.d2    =*/ params[8],
+    };
+
+    auto pipeline = ggml_metal_library_get_pipeline_im2col_3d(lib, op);
+
+    const int32_t max_t = ggml_metal_pipeline_max_theads_per_threadgroup(pipeline);
+    const int32_t nth   = std::min<int32_t>(std::min<int32_t>(256, max_t), ((CDHW + 31)/32)*32);
+    const int32_t ntg0  = (CDHW + nth - 1)/nth;
+
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(src1), 1);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op),   2);
+
+    ggml_metal_encoder_dispatch_threadgroups(enc, ntg0, OH, OW, nth, 1, 1);
+
+    return 1;
+}
