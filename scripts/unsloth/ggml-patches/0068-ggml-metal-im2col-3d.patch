+typedef void (im2col_3d_t)(
+        constant ggml_metal_kargs_im2col_3d & args,
+        device const float * x,
+        device        char * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3  tgpg[[threadgroups_per_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]]);
+
+// [N*IC, ID, IH, IW] => [N*OD, OH, OW, IC*KD*KH*KW], one thread per element of the contiguous dst row (as
+// kernel_im2col_flat), looping over N*OD.
+// grid: [ceil(CDHW/ntg0), OH, OW], threadgroup: [ntg0, 1, 1]
+template <typename T>
+kernel void kernel_im2col_3d(
+        constant ggml_metal_kargs_im2col_3d & args,
+        device const float * x,
+        device        char * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3  tgpg[[threadgroups_per_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]]) {
+    const int64_t k = (int64_t) tgpig[0]*ntg[0] + tpitg[0];
+    if (k >= args.CDHW) {
+        return;
+    }
+
+    const int64_t OH  = tgpg[1];
+    const int64_t OW  = tgpg[2];
+    const int64_t ioh = tgpig[1];
+    const int64_t iow = tgpig[2];
+
+    const int64_t iic = k / args.KDHW;
+    int64_t       r   = k - iic*args.KDHW;
+    const int64_t ikd = r / args.KHW;
+    r                -= ikd*args.KHW;
+    const int64_t ikh = r / args.KW;
+    const int64_t ikw = r - ikh*args.KW;
+
+    const int64_t iiw = iow*args.s0 + ikw*args.d0 - args.p0;
+    const int64_t iih = ioh*args.s1 + ikh*args.d1 - args.p1;
+    const bool    hw  = iih >= 0 && iih < args.IH && iiw >= 0 && iiw < args.IW;
+
+    const int64_t dst_n = OH*OW*(int64_t) args.CDHW;
+
+    device T * pdst = (device T *) dst + (ioh*OW + iow)*args.CDHW + k;
+
+    for (int64_t in = 0; in < args.N; ++in) {
+        device const float * px = x + (in*args.IC + iic)*args.ofs_c + iih*args.ofs_h + iiw;
+        for (int64_t iod = 0; iod < args.OD; ++iod) {
+            const int64_t iid = iod*args.s2 + ikd*args.d2 - args.p2;
+            pdst[(in*args.OD + iod)*dst_n] = hw && iid >= 0 && iid < args.ID ? (T) px[iid*args.ofs_d] : (T) 0.0f;
+        }
+    }
+}
+
+template [[host_name("kernel_im2col_3d_f32")]] kernel im2col_3d_t kernel_im2col_3d<float>;
+template [[host_name("kernel_im2col_3d_f16")]] kernel im2col_3d_t kernel_im2col_3d<half>;
