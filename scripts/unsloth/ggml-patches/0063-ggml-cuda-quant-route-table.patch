diff --git a/src/ggml-cuda/quant-route.h b/src/ggml-cuda/quant-route.h
new file mode 100644
index 0000000..2f79504
--- /dev/null
+++ b/src/ggml-cuda/quant-route.h
@@ -0,0 +1,93 @@
+#pragma once
+
+// Which large-batch quantized matmuls take dequant + BF16 cuBLAS instead of MMQ, per (architecture, weight type).
+// Host-only and free of CUDA headers so the policy can be checked with a plain C++ compiler
+// (scripts/quant_route_table_test.cpp in stable-diffusion.cpp).
+//
+// MMQ quantizes the activations to q8_1 and runs int8 MMA: the right call at LLM prompt sizes. At diffusion
+// transformer sizes (10^3-10^4 rows per call) a BF16 tensor-core GEMM on the dequantized weight wins where the BF16
+// rate is not far below the int8 rate, and it keeps the activations in BF16.
+//
+// Measured per type on stable-diffusion.cpp renders (FLUX.2 klein 4B, FLUX.3 klein, Z-Image Turbo, Qwen-Image 2.1
+// Turbo; 512 / 768 / 1024 px; steady s/step, 3 interleaved repeats; LPIPS vs the BF16 / F16 GGUF render):
+//   sm80 (A100-40GB):     every K-quant file 1.9-2.2x faster per step on cuBLAS at 1024 px, 1.7-1.8x at 512 px
+//                         (1024-1536 rows); LPIPS vs BF16 equal or lower.
+//   sm120 (RTX PRO 6000): Q6_K 1.20-1.22x at 1024 px and 1.10-1.18x at 1024-2800 rows; Q4_K alone 1.015-1.11x
+//                         and Q5_K alone 1.03-1.05x at >= 4096 rows, both slower below that; Q8_0 within +-2.5%,
+//                         kept at 4096 as patch 0016.
+//   sm89 (L4):            Q6_K 1.04-1.06x at 1024 px; Q4_K / Q5_K alone tie or lose up to 3%, Q8_0 loses 5-6%.
+//   sm75 (T4): no BF16 tensor cores, MMQ. sm86, sm87, sm90, sm100, sm121: not measured for K-quants.
+// Rows = src1 rows (ne11 * ne12 * ne13). A type missing from the table keeps MMQ.
+
+#include "ggml.h"
+
+#include <cstdint>
+
+struct ggml_cuda_quant_route_rule {
+    int       cc_min;    // ggml-cuda compute capability (100 * major + 10 * minor), inclusive
+    int       cc_max;    // exclusive
+    ggml_type type;
+    int64_t   min_rows;  // use dequant + BF16 cuBLAS from this many src1 rows; 0 = MMQ
+};
+
+static constexpr ggml_cuda_quant_route_rule ggml_cuda_quant_route_table[] = {
+    // A100 (sm80 only: consumer Ampere / Orin int8 is twice their BF16-with-FP32-accumulate rate)
+    {  800,  810, GGML_TYPE_Q8_0, 1024 },
+    {  800,  810, GGML_TYPE_Q4_K, 1024 },
+    {  800,  810, GGML_TYPE_Q5_K, 1024 },
+    {  800,  810, GGML_TYPE_Q6_K, 1024 },
+    // Ada (sm89, measured on an L4): Q6_K only; Q4_K / Q5_K / Q8_0 tie or lose on cuBLAS there
+    {  890,  900, GGML_TYPE_Q6_K, 4096 },
+    // Hopper and datacenter Blackwell (sm90 / sm100 / sm103): Q8_0 only, as patch 0016
+    {  900, 1100, GGML_TYPE_Q8_0, 1024 },
+    // Blackwell workstation / consumer: Q8_0 on sm120 and sm121 as patch 0016; the K-quants on sm120 only
+    // (measured on an RTX PRO 6000; GB10 / sm121 has a fraction of the memory bandwidth the dequant pass needs).
+    { 1200, 1300, GGML_TYPE_Q8_0, 4096 },
+    { 1200, 1210, GGML_TYPE_Q4_K, 4096 },
+    { 1200, 1210, GGML_TYPE_Q5_K, 4096 },
+    { 1200, 1210, GGML_TYPE_Q6_K, 1024 },
+};
+
+// Default rows from which (cc, type) leaves MMQ for dequant + BF16 cuBLAS; 0 keeps MMQ.
+static inline int64_t ggml_cuda_quant_route_default_min_rows(int cc, ggml_type type) {
+    for (const ggml_cuda_quant_route_rule & r : ggml_cuda_quant_route_table) {
+        if (cc >= r.cc_min && cc < r.cc_max && r.type == type) {
+            return r.min_rows;
+        }
+    }
+    return 0;
+}
+
+// Resolve the policy with the environment overrides applied:
+//   env_min_batch  GGML_CUDA_QUANT_CUBLAS_MIN_BATCH (-1 = unset): rows for every quantized type, 0 = MMQ everywhere
+//   env_types      GGML_CUDA_QUANT_CUBLAS_TYPES (nullptr = unset): comma list of type names (ggml_type_name, e.g.
+//                  "q4_K,q6_K") the MIN_BATCH override applies to; other types keep the table default
+// type_name is ggml_type_name(type), passed in so this header does not need the ggml library.
+static inline int64_t ggml_cuda_quant_route_min_rows(int cc, ggml_type type, const char * type_name,
+                                                     int64_t env_min_batch, const char * env_types) {
+    if (env_min_batch < 0) {
+        return ggml_cuda_quant_route_default_min_rows(cc, type);
+    }
+    if (env_types == nullptr || type_name == nullptr) {
+        return env_min_batch;
+    }
+    // exact, case-sensitive match of one comma-separated entry
+    const char * p = env_types;
+    while (*p != '\0') {
+        const char * e = p;
+        while (*e != '\0' && *e != ',') {
+            e++;
+        }
+        const char * n = type_name;
+        const char * q = p;
+        while (q < e && *n != '\0' && *q == *n) {
+            q++;
+            n++;
+        }
+        if (q == e && *n == '\0' && e > p) {
+            return env_min_batch;
+        }
+        p = *e == ',' ? e + 1 : e;
+    }
+    return ggml_cuda_quant_route_default_min_rows(cc, type);
+}
