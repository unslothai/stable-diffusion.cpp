diff --git a/src/ggml-cuda/rope-pe.cu b/src/ggml-cuda/rope-pe.cu
index 3afe4423..b6dd7a69 100644
--- a/src/ggml-cuda/rope-pe.cu
+++ b/src/ggml-cuda/rope-pe.cu
@@ -44,6 +44,112 @@ static __global__ void rope_pe_permute_kernel(
     }
 }
 
+// Same op with every head row RMS-normalised first (no weight). One block of block_size threads
+// per (token, batch), the size and reduction rms_norm_f32_cuda's small-row path uses for this row
+// length, so each normalised value is bit-identical to GGML_OP_RMS_NORM's; the normalised row is
+// staged in shared memory for the RoPE partner reads.
+template <typename dst_t, bool has_scale, int block_size>
+static __global__ void rope_pe_permute_rms_kernel(
+        const char * __restrict__ x, const float * __restrict__ pe, dst_t * __restrict__ dst,
+        const int D, const int H, const int64_t L, const int n_rot,
+        const int64_t nb01, const int64_t nb02, const int64_t nb03,
+        const float scale, const float bias, const float eps) {
+    const int64_t l    = blockIdx.x;
+    const int64_t n    = blockIdx.y;
+    const int     half = n_rot / 2;
+    const int     i    = threadIdx.x;
+
+    __shared__ float s_sum[32];
+    __shared__ float xs[block_size];
+
+    const bool rot = i < n_rot;
+    int   j  = i;
+    float c0 = 0.0f;
+    float c1 = 0.0f;
+    if (rot) {
+        const int r = i >= half;
+        j           = i - r * half;
+        const float * t = pe + (l * half + j) * 4 + 2 * r;
+        c0 = t[0];
+        c1 = t[1];
+    }
+    for (int h = 0; h < H; ++h) {
+        const float * xr = (const float *) (x + h * nb01 + l * nb02 + n * nb03);
+        float xi  = 0.0f;
+        float tmp = 0.0f;
+        if (i < D) {
+            xi = xr[i];
+            tmp += xi * xi;
+        }
+        tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+        const float mean = tmp / D;
+        const float sc   = rsqrtf(mean + eps);
+        if (i < D) {
+            xs[i] = sc * xi;
+        }
+        __syncthreads();
+        if (i < D) {
+            float y;
+            if (rot) {
+                y = __fadd_rn(__fmul_rn(xs[j], c0), __fmul_rn(xs[j + half], c1));
+            } else {
+                y = xs[i];
+            }
+            if constexpr (has_scale) {
+                y = scale * y + bias;
+            }
+            dst[((n * H + h) * L + l) * D + i] = ggml_cuda_cast<dst_t>(y);
+        }
+        __syncthreads();
+    }
+}
+
+// rms_norm_f32_cuda takes its small-row path (and so its reduction order) only here.
+static bool rope_pe_rms_small_rows_enabled() {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    return false;
+#else
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_NORM_SMALL_ROWS");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return enabled && WARP_SIZE == 32;
+#endif
+}
+
+template <typename dst_t, int block_size>
+static void rope_pe_permute_rms_launch(const ggml_tensor * src0, const float * pe, dst_t * dst, const int n_rot,
+                                       const float scale, const float eps, cudaStream_t stream) {
+    const int     D = (int) src0->ne[0];
+    const int     H = (int) src0->ne[1];
+    const int64_t L = src0->ne[2];
+    const int64_t N = src0->ne[3];
+    const dim3 grid((unsigned int) L, (unsigned int) N, 1);
+    const dim3 block(block_size, 1, 1);
+    const char * x = (const char *) src0->data;
+    if (scale != 1.0f) {
+        rope_pe_permute_rms_kernel<dst_t, true, block_size><<<grid, block, 0, stream>>>(
+            x, pe, dst, D, H, L, n_rot, src0->nb[1], src0->nb[2], src0->nb[3], scale, 0.0f, eps);
+    } else {
+        rope_pe_permute_rms_kernel<dst_t, false, block_size><<<grid, block, 0, stream>>>(
+            x, pe, dst, D, H, L, n_rot, src0->nb[1], src0->nb[2], src0->nb[3], scale, 0.0f, eps);
+    }
+}
+
+template <typename dst_t>
+static void rope_pe_permute_rms_cuda(const ggml_tensor * src0, const float * pe, dst_t * dst, const int n_rot,
+                                     const float scale, const float eps, cudaStream_t stream) {
+    const int D = (int) src0->ne[0];
+    GGML_ASSERT(D <= 128);
+    if (D <= 32) {
+        rope_pe_permute_rms_launch<dst_t, 32>(src0, pe, dst, n_rot, scale, eps, stream);
+    } else if (D <= 64) {
+        rope_pe_permute_rms_launch<dst_t, 64>(src0, pe, dst, n_rot, scale, eps, stream);
+    } else {
+        rope_pe_permute_rms_launch<dst_t, 128>(src0, pe, dst, n_rot, scale, eps, stream);
+    }
+}
+
 template <typename dst_t>
 static void rope_pe_permute_cuda(const ggml_tensor * src0, const float * pe, dst_t * dst, const int n_rot,
                                  const float scale, cudaStream_t stream) {
@@ -78,6 +184,17 @@ void ggml_cuda_op_rope_pe_permute(ggml_backend_cuda_context & ctx, ggml_tensor *
     cudaStream_t  stream = ctx.stream();
     const float * pe_d   = pe ? (const float *) pe->data : nullptr;
 
+    if (ggml_get_op_params_i32(dst, 2) != 0) {
+        const float eps = ggml_get_op_params_f32(dst, 3);
+        if (dst->type == GGML_TYPE_F16) {
+            rope_pe_permute_rms_cuda(src0, pe_d, (half *) dst->data, n_rot, scale, eps, stream);
+        } else {
+            GGML_ASSERT(dst->type == GGML_TYPE_F32);
+            rope_pe_permute_rms_cuda(src0, pe_d, (float *) dst->data, n_rot, scale, eps, stream);
+        }
+        return;
+    }
+
     if (dst->type == GGML_TYPE_F16) {
         rope_pe_permute_cuda(src0, pe_d, (half *) dst->data, n_rot, scale, stream);
     } else {
@@ -98,5 +215,8 @@ bool ggml_cuda_rope_pe_permute_supported(const ggml_tensor * op) {
     if (src0->ne[2] > INT_MAX || src0->ne[3] > 65535 || src0->ne[1] > INT_MAX || src0->ne[0] > INT_MAX) {
         return false;
     }
+    if (ggml_get_op_params_i32(op, 2) != 0 && (src0->ne[0] > 128 || !rope_pe_rms_small_rows_enabled())) {
+        return false;
+    }
     return pe == nullptr || (pe->type == GGML_TYPE_F32 && ggml_is_contiguous(pe));
 }
diff --git a/src/ggml.c b/src/ggml.c
index fec933bf..62a157c6 100644
--- a/src/ggml.c
+++ b/src/ggml.c
@@ -5594,6 +5594,21 @@ struct ggml_tensor * ggml_rope_pe_permute(
     return result;
 }
 
+struct ggml_tensor * ggml_rope_pe_permute_rms(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * pe,
+        int                   n_rot,
+        float                 scale,
+        enum ggml_type        type,
+        float                 eps) {
+    GGML_ASSERT(eps >= 0.0f);
+    struct ggml_tensor * result = ggml_rope_pe_permute(ctx, a, pe, n_rot, scale, type);
+    ggml_set_op_params_i32(result, 2, 1);
+    ggml_set_op_params_f32(result, 3, eps);
+    return result;
+}
+
 static struct ggml_tensor * ggml_modulate_rows_impl(
         struct ggml_context * ctx,
         struct ggml_tensor  * acc,
