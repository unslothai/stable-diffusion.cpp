{
  "schema_version": 1,
  "id": "minimax-h3-image",
  "name": "MiniMax H3 Image",
  "size_multiple": 32,
  "description": "Text-to-image and reference-image editing with the six-step PDD checkpoint. Requires the MiniMax-H3-Image 2D VAE and MiniMax-H3 Qwen3-VL-32B text encoder with its vision tower.",
  "model_url": "https://huggingface.co/MiniMaxAI/MiniMax-H3-Image",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "MiniMax-H3 Qwen 3 VL 32B Text Encoder"
    },
    {
      "id": "llm_vision",
      "required": false,
      "label": "Vision tower (required when not included in the text encoder)"
    },
    {
      "id": "vae",
      "required": true,
      "label": "MiniMax-H3-Image 2D VAE"
    }
  ],
  "defaults": {
    "sampling_method": "euler",
    "scheduler": "simple",
    "cfg_scale": 1,
    "steps": 6,
    "width": 2048,
    "height": 2048
  },
  "features": [
    "ref_images"
  ]
}
